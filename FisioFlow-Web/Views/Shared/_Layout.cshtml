<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FisioFlow</title>


    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <style>


        :root {

            --ff-primary:#10b981;
            --ff-primary-dark:#047857;
            --ff-green-dark:#064e3b;
            --ff-bg:#f1f5f9;

        }



        * {

            box-sizing:border-box;

        }



        body {

            min-height:100vh;

            display:flex;

            flex-direction:column;

            background:var(--ff-bg);

            font-family:
            "Segoe UI",
            Inter,
            sans-serif;

            color:#1e293b;

        }



        /* =========================
           NAVBAR
        ========================= */


        .navbar-custom {


            background:
            linear-gradient(
                135deg,
                #022c22,
                #047857
            ) !important;


            padding:15px 0;


            box-shadow:
            0 8px 25px rgba(0,0,0,.15);


        }



        .navbar-brand {


            color:white !important;


            font-size:26px;


            font-weight:800;


            letter-spacing:-.5px;


            display:flex;


            align-items:center;


            gap:10px;


        }



        .navbar-brand-icon {


            width:42px;

            height:42px;


            display:flex;

            align-items:center;

            justify-content:center;


            border-radius:12px;


            background:
            linear-gradient(
                135deg,
                #10b981,
                #34d399
            );


            color:white;


        }



        .nav-link {


            color:
            rgba(255,255,255,.85)
            !important;


            font-weight:600;


            padding:
            10px 18px !important;


            border-radius:12px;


            transition:.3s;


        }




        .nav-link:hover {


            background:
            rgba(255,255,255,.12);


            color:white !important;


        }




        /* BOTÃO ADMIN */


        .btn-admin {


            background:white;


            color:#047857 !important;


            border-radius:14px;


            padding:
            11px 22px;


            font-weight:700;


            border:none;


            box-shadow:
            0 8px 20px rgba(0,0,0,.15);


            transition:.3s;


        }



        .btn-admin:hover {


            background:#ecfdf5;


            transform:
            translateY(-2px);


            color:#064e3b !important;


        }







        /* =========================
           CONTEÚDO
        ========================= */


        .page-container {


            flex:1;


            padding:
            35px 0;


        }




        main {


            background:white;


            border-radius:22px;


            padding:40px;


            min-height:400px;


            box-shadow:

            0 10px 30px
            rgba(15,23,42,.06);


        }







        /* =========================
           FOOTER
        ========================= */



        footer {


            background:white;


            border-top:

            1px solid #e2e8f0;


            padding:25px 0;


            color:#64748b;


        }



        footer strong {


            color:#047857;


            font-weight:800;


        }







        /* MOBILE */


        .navbar-toggler {


            border:
            1px solid rgba(255,255,255,.4);


        }



        .navbar-toggler-icon {


            filter:
            brightness(0) invert(1);


        }



    </style>


</head>





<body>



<header>


<nav class="navbar navbar-expand-lg navbar-custom">


<div class="container">



<a class="navbar-brand"
   asp-controller="Home"
   asp-action="Index">


    <span class="navbar-brand-icon">

        <i class="fa-solid fa-heart-pulse"></i>

    </span>


    FisioFlow


</a>





<button class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#menu">


<span class="navbar-toggler-icon"></span>


</button>







<div class="collapse navbar-collapse"
     id="menu">


<ul class="navbar-nav ms-auto align-items-center">



<li class="nav-item">

<a class="nav-link"
   asp-controller="Home"
   asp-action="Index">

<i class="fa-solid fa-house me-1"></i>

Início

</a>

</li>





<li class="nav-item ms-lg-3">


<a class="btn-admin"
   asp-controller="Auth"
   asp-action="Login">


<i class="fa-solid fa-lock me-2"></i>

Área Administrativa


</a>


</li>



</ul>



</div>


</div>


</nav>


</header>








<div class="page-container">





<main role="main">


@RenderBody()


</main>





</div>









<footer>


<div class="container text-center">


<div>


<strong>

FisioFlow

</strong>


© @DateTime.Now.Year


</div>



<div class="small mt-1">


Sistema inteligente para gestão de clínicas de fisioterapia.


</div>



</div>


</footer>








<script src="~/lib/jquery/dist/jquery.min.js"></script>


<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


<script src="~/js/site.js"
        asp-append-version="true"></script>


@await RenderSectionAsync("Scripts",
required:false)


</body>


</html>