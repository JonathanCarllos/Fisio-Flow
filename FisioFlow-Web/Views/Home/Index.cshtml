@{
    ViewData["Title"] = "Início";
}

<style>
    :root {
        --green: #10b981;
        --green-light: #34d399;
        --green-dark: #047857;
        --green-deep: #022c22;
        --green-soft: #ecfdf5;
        --white: #ffffff;
        --gray: #64748b;
        --dark: #0f172a;
        --light: #f8fafc;
        --border: #e2e8f0;
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        font-family: "Inter", Arial, sans-serif;
        color: var(--dark);
        background: #ffffff;
    }

    /* HERO */

    .home-hero {
        position: relative;
        width: 100%;
        min-height: 800px;
        padding: 120px 0 90px;
        overflow: hidden;
        background: radial-gradient(circle at 80% 30%, rgba(52,211,153,.18), transparent 30%), radial-gradient(circle at 10% 80%, rgba(16,185,129,.12), transparent 30%), linear-gradient(135deg, #022c22 0%, #064e3b 55%, #022c22 100%);
    }

        .home-hero::before {
            content: "";
            position: absolute;
            width: 700px;
            height: 700px;
            right: -300px;
            top: 40px;
            border: 1px solid rgba(52,211,153,.15);
            border-radius: 50%;
        }

        .home-hero::after {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            left: -300px;
            bottom: -250px;
            border: 1px solid rgba(52,211,153,.10);
            border-radius: 50%;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 16px;
        margin-bottom: 22px;
        border: 1px solid rgba(52,211,153,.35);
        border-radius: 30px;
        color: #d1fae5;
        background: rgba(16,185,129,.10);
        font-size: 12px;
        font-weight: 800;
    }

        .hero-badge i {
            color: var(--green-light);
        }

    .hero-small {
        margin-bottom: 5px;
        color: #ffffff;
        font-size: 19px;
        font-weight: 700;
    }

    .hero-green {
        color: var(--green-light);
        font-size: 22px;
        font-weight: 800;
    }

    .hero-line {
        width: 55px;
        height: 4px;
        margin: 20px 0;
        border-radius: 10px;
        background: var(--green-light);
    }

    .home-hero h1 {
        max-width: 650px;
        margin: 0 0 25px;
        color: #ffffff;
        font-size: clamp(42px, 5vw, 68px);
        line-height: .98;
        letter-spacing: -3px;
        font-weight: 900;
    }

        .home-hero h1 span {
            color: var(--green-light);
        }

    .hero-description {
        max-width: 600px;
        margin-bottom: 30px;
        color: #cbd5e1;
        font-size: 16px;
        line-height: 1.8;
    }

    .hero-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
    }

    .btn-home-green,
    .btn-home-outline {
        min-height: 50px;
        padding: 0 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        border-radius: 14px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        transition: .25s;
    }

    .home-hero > .container {
        max-width: 1600px;
        width: 100%;
        padding-left: 25px;
        padding-right: 25px;
    }

    .btn-home-green {
        color: white;
        background: var(--green);
        box-shadow: 0 12px 30px rgba(16,185,129,.25);
    }

        .btn-home-green:hover {
            color: white;
            background: var(--green-light);
            transform: translateY(-3px);
        }

    .btn-home-outline {
        color: white;
        border: 1px solid rgba(255,255,255,.25);
        background: rgba(255,255,255,.05);
    }

        .btn-home-outline:hover {
            color: white;
            border-color: var(--green-light);
            background: rgba(16,185,129,.15);
        }

    /* DASHBOARD */

    .dashboard-container {
        position: relative;
        margin-left: 30px;
    }

    .dashboard-glow {
        position: absolute;
        top: 40px;
        right: -60px;
        width: 430px;
        height: 430px;
        border-radius: 50%;
        background: rgba(52,211,153,.25);
        filter: blur(100px);
    }

    .dashboard {
        position: relative;
        overflow: hidden;
        border: 6px solid rgba(255,255,255,.12);
        border-radius: 28px;
        background: #f8fafc;
        box-shadow: 0 40px 90px rgba(0,0,0,.45);
        transform: perspective(1400px) rotateY(-4deg) rotateX(2deg);
    }

    .dashboard-header {
        height: 48px;
        padding: 0 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #022c22;
    }

    .dashboard-brand {
        color: white;
        font-size: 11px;
        font-weight: 900;
    }

        .dashboard-brand i {
            margin-right: 5px;
            color: var(--green-light);
        }

        .dashboard-brand span {
            color: var(--green-light);
        }

    .dashboard-header-links {
        display: flex;
        gap: 18px;
    }

        .dashboard-header-links span {
            color: #cbd5e1;
            font-size: 7px;
            font-weight: 700;
        }

    .dashboard-body {
        display: flex;
        min-height: 405px;
    }

    .dashboard-sidebar {
        width: 145px;
        padding: 14px 10px;
        background: #052e24;
    }

    .dashboard-user {
        display: flex;
        align-items: center;
        gap: 7px;
        padding-bottom: 14px;
        margin-bottom: 10px;
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .dashboard-user-icon {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: white;
        background: var(--green);
        font-size: 9px;
    }

    .dashboard-user strong,
    .dashboard-user small {
        display: block;
    }

    .dashboard-user strong {
        color: white;
        font-size: 7px;
    }

    .dashboard-user small {
        margin-top: 2px;
        color: #94a3b8;
        font-size: 6px;
    }

    .sidebar-item {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 9px 7px;
        margin-bottom: 2px;
        border-radius: 8px;
        color: #9ca3af;
        font-size: 7px;
        font-weight: 600;
    }

        .sidebar-item i {
            width: 12px;
            text-align: center;
        }

        .sidebar-item.active {
            color: white;
            background: rgba(16,185,129,.18);
        }

            .sidebar-item.active i {
                color: var(--green-light);
            }

    .dashboard-content {
        flex: 1;
        padding: 17px;
    }

    .dashboard-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

        .dashboard-title small {
            color: #64748b;
            font-size: 7px;
        }

        .dashboard-title h3 {
            margin: 3px 0 0;
            color: #0f172a;
            font-size: 17px;
            font-weight: 800;
        }

        .dashboard-title button {
            padding: 7px 10px;
            border: none;
            border-radius: 8px;
            color: white;
            background: var(--green);
            font-size: 7px;
            font-weight: 700;
        }

    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 7px;
        margin-bottom: 9px;
    }

    .dashboard-stat {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 9px;
        border: 1px solid #edf0f2;
        border-radius: 9px;
        background: white;
    }

    .dashboard-stat-icon {
        width: 25px;
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        color: var(--green);
        background: var(--green-soft);
        font-size: 9px;
    }

    .dashboard-stat small,
    .dashboard-stat strong {
        display: block;
    }

    .dashboard-stat small {
        color: #64748b;
        font-size: 5px;
    }

    .dashboard-stat strong {
        color: #0f172a;
        font-size: 10px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 8px;
    }

    .dashboard-card {
        padding: 11px;
        border: 1px solid #edf0f2;
        border-radius: 10px;
        background: white;
    }

    .dashboard-card-title {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

        .dashboard-card-title strong {
            font-size: 8px;
        }

        .dashboard-card-title span {
            color: var(--green);
            font-size: 6px;
        }

    .fake-chart {
        position: relative;
        height: 110px;
        overflow: hidden;
        border-bottom: 1px solid #e5e7eb;
        background: repeating-linear-gradient( to bottom, transparent, transparent 27px, #f1f5f9 28px );
    }

    .fake-line {
        position: absolute;
        top: 55px;
        left: -5%;
        width: 110%;
        height: 2px;
        background: var(--green);
        transform: rotate(-5deg);
    }

        .fake-line.two {
            top: 73px;
            opacity: .5;
            transform: rotate(5deg);
        }

        .fake-line.three {
            top: 40px;
            opacity: .25;
            transform: rotate(-8deg);
        }

    .agenda-item {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 10px;
    }

        .agenda-item span {
            color: #64748b;
            font-size: 6px;
        }

        .agenda-item div {
            flex: 1;
            height: 5px;
            border-radius: 10px;
            background: #e2e8f0;
        }

        .agenda-item b {
            color: var(--green);
            font-size: 5px;
        }

    .dashboard-bottom {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 7px;
        margin-top: 8px;
    }

    .dashboard-bottom-item {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 8px;
        border: 1px solid #edf0f2;
        border-radius: 8px;
        background: white;
    }

        .dashboard-bottom-item i {
            color: var(--green);
            font-size: 9px;
        }

        .dashboard-bottom-item span {
            font-size: 6px;
            font-weight: 700;
        }

    /* BENEFÍCIOS */

    .benefits {
        position: relative;
        z-index: 5;
        margin-top: -45px;
    }

    .benefits-box {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        padding: 20px;
        border: 1px solid var(--border);
        border-radius: 25px;
        background: white;
        box-shadow: 0 25px 70px rgba(15,23,42,.08);
    }

    .benefit {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px 20px;
        border-right: 1px solid var(--border);
    }

        .benefit:last-child {
            border-right: none;
        }

    .benefit-icon {
        min-width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #bbf7d0;
        border-radius: 15px;
        color: var(--green);
        background: var(--green-soft);
    }

    .benefit strong {
        font-size: 14px;
    }

    .benefit p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 11px;
        line-height: 1.4;
    }

    /* SEÇÕES */

    .home-section {
        padding: 105px 0;
    }

    .home-section-light {
        background: #f8fafc;
    }

    .section-heading {
        max-width: 800px;
        margin: 0 auto 55px;
        text-align: center;
    }

    .section-label {
        display: inline-block;
        padding: 7px 14px;
        margin-bottom: 14px;
        border-radius: 30px;
        color: var(--green-dark);
        background: var(--green-soft);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .5px;
    }

    .section-heading h2 {
        margin-bottom: 15px;
        font-size: clamp(32px, 4vw, 48px);
        line-height: 1.05;
        letter-spacing: -2px;
        font-weight: 900;
    }

        .section-heading h2 span {
            color: var(--green);
        }

    .section-heading p {
        color: #64748b;
        font-size: 15px;
        line-height: 1.7;
    }

    /* CARDS */

    .home-card {
        height: 100%;
        padding: 30px;
        border: 1px solid var(--border);
        border-radius: 22px;
        background: white;
        box-shadow: 0 15px 40px rgba(15,23,42,.04);
        transition: .25s;
    }

        .home-card:hover {
            border-color: #86efac;
            box-shadow: 0 25px 55px rgba(16,185,129,.12);
            transform: translateY(-7px);
        }

    .home-card-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 22px;
        border-radius: 16px;
        color: var(--green);
        background: var(--green-soft);
        font-size: 20px;
    }

    .home-card h3 {
        margin-bottom: 12px;
        font-size: 19px;
        font-weight: 800;
    }

    .home-card p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        line-height: 1.7;
    }

    /* CONTATO */

    .home-contact {
        padding: 80px 0;
    }

    .contact-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 60px;
        border-radius: 30px;
        color: white;
        background: radial-gradient(circle at 90% 50%, rgba(52,211,153,.25), transparent 35%), linear-gradient(135deg, #022c22, #064e3b);
        box-shadow: 0 30px 70px rgba(2,44,34,.15);
    }

    .contact-label {
        color: var(--green-light);
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1px;
    }

    .contact-box h2 {
        max-width: 650px;
        margin: 10px 0;
        font-size: 38px;
        font-weight: 900;
        letter-spacing: -1.5px;
    }

    .contact-box p {
        margin: 0;
        color: #cbd5e1;
    }

    /* CHAT */

    .home-chat {
        position: fixed;
        right: 25px;
        bottom: 25px;
        z-index: 1000;
        width: 58px;
        height: 58px;
        border: none;
        border-radius: 50%;
        color: white;
        background: var(--green);
        font-size: 21px;
        box-shadow: 0 12px 35px rgba(16,185,129,.35);
        transition: .25s;
    }

        .home-chat:hover {
            background: var(--green-dark);
            transform: translateY(-4px);
        }

    /* RESPONSIVO */

    @@media (max-width: 991px) {

        .home-hero {
            padding: 130px 0 90px;
        }

        .dashboard-container {
            margin: 60px 0 0;
        }

        .dashboard {
            transform: none;
        }

        .benefits-box {
            grid-template-columns: repeat(2, 1fr);
        }

        .benefit:nth-child(2) {
            border-right: none;
        }

        .benefit:nth-child(-n+2) {
            border-bottom: 1px solid var(--border);
            padding-bottom: 20px;
        }

        .benefit:nth-child(n+3) {
            padding-top: 20px;
        }
    }

    @@media (max-width: 767px) {

        .home-hero {
            min-height: auto;
            padding: 120px 0 70px;
        }

            .home-hero h1 {
                letter-spacing: -2px;
            }

        .hero-buttons {
            flex-direction: column;
        }

        .btn-home-green,
        .btn-home-outline {
            width: 100%;
        }

        .dashboard-container {
            display: none;
        }

        .benefits {
            margin-top: -20px;
        }

        .benefits-box {
            grid-template-columns: 1fr;
        }

        .benefit {
            border-right: none;
            border-bottom: 1px solid var(--border);
            padding: 18px 10px !important;
        }

            .benefit:last-child {
                border-bottom: none;
            }

        .home-section {
            padding: 75px 0;
        }

        .contact-box {
            flex-direction: column;
            align-items: flex-start;
            padding: 40px 30px;
        }

            .contact-box h2 {
                font-size: 30px;
            }
    }
</style>

