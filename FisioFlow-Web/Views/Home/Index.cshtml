@{
    ViewData["Title"] = "Início";
}

<style>
    :root {
        --green-50: #ecfdf5;
        --green-100: #d1fae5;
        --green-200: #a7f3d0;
        --green-400: #34d399;
        --green-500: #10b981;
        --green-600: #059669;
        --green-700: #047857;
        --green-800: #065f46;
        --green-900: #064e3b;
        --green-950: #022c22;
        --white: #ffffff;
        --slate-50: #f8fafc;
        --slate-100: #f1f5f9;
        --slate-200: #e2e8f0;
        --slate-500: #64748b;
        --slate-600: #475569;
        --slate-700: #334155;
        --slate-900: #0f172a;
        --radius-lg: 24px;
        --radius-xl: 32px;
        --shadow-sm: 0 10px 30px rgba(15, 23, 42, .06);
        --shadow-lg: 0 30px 80px rgba(15, 23, 42, .12);
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        color: var(--slate-900);
        background: var(--white);
        font-family: "Inter", Arial, sans-serif;
    }

    /* =========================================================
           HERO VERDE
           ========================================================= */

    .ff-hero {
        position: relative;
        overflow: hidden;
        min-height: 760px;
        padding: 110px 0 100px;
        color: var(--white);
        background: radial-gradient(circle at 85% 20%, rgba(52, 211, 153, .22), transparent 25%), radial-gradient(circle at 10% 90%, rgba(16, 185, 129, .16), transparent 30%), linear-gradient(135deg, var(--green-950), var(--green-900) 55%, var(--green-950));
    }

        .ff-hero::before,
        .ff-hero::after {
            content: "";
            position: absolute;
            border: 1px solid rgba(255, 255, 255, .08);
            border-radius: 50%;
            pointer-events: none;
        }

        .ff-hero::before {
            width: 650px;
            height: 650px;
            right: -300px;
            top: -180px;
        }

        .ff-hero::after {
            width: 500px;
            height: 500px;
            left: -300px;
            bottom: -300px;
        }

    .ff-container {
        position: relative;
        z-index: 2;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 28px;
    }

    .ff-hero-content {
        padding-right: 35px;
    }

    .ff-badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 15px;
        margin-bottom: 22px;
        border: 1px solid rgba(52, 211, 153, .35);
        border-radius: 50px;
        color: var(--green-100);
        background: rgba(16, 185, 129, .10);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .2px;
    }

        .ff-badge i {
            color: var(--green-400);
        }

    .ff-hero-small {
        margin-bottom: 7px;
        color: var(--white);
        font-size: 18px;
        font-weight: 700;
    }

    .ff-hero-highlight {
        color: var(--green-400);
        font-size: 22px;
        font-weight: 800;
    }

    .ff-line {
        width: 55px;
        height: 4px;
        margin: 20px 0;
        border-radius: 20px;
        background: var(--green-400);
    }

    .ff-hero h1 {
        max-width: 680px;
        margin: 0 0 25px;
        color: var(--white);
        font-size: clamp(42px, 5vw, 68px);
        line-height: .98;
        letter-spacing: -3px;
        font-weight: 900;
    }

        .ff-hero h1 span {
            color: var(--green-400);
        }

    .ff-hero-description {
        max-width: 610px;
        margin-bottom: 30px;
        color: #cbd5e1;
        font-size: 16px;
        line-height: 1.8;
    }

    .ff-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 13px;
    }

    .ff-btn {
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 0 23px;
        border-radius: 14px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        transition: .25s ease;
    }

    .ff-btn-green {
        color: var(--white);
        background: var(--green-500);
        box-shadow: 0 14px 35px rgba(16, 185, 129, .25);
    }

        .ff-btn-green:hover {
            color: var(--white);
            background: var(--green-400);
            transform: translateY(-3px);
        }

    .ff-btn-outline {
        color: var(--white);
        border: 1px solid rgba(255, 255, 255, .22);
        background: rgba(255, 255, 255, .05);
    }

        .ff-btn-outline:hover {
            color: var(--white);
            border-color: var(--green-400);
            background: rgba(16, 185, 129, .12);
            transform: translateY(-3px);
        }

    /* =========================================================
           DASHBOARD
           ========================================================= */

    .ff-dashboard-wrapper {
        position: relative;
    }

    .ff-dashboard-glow {
        position: absolute;
        width: 420px;
        height: 420px;
        right: -70px;
        top: 40px;
        border-radius: 50%;
        background: rgba(52, 211, 153, .25);
        filter: blur(100px);
    }

    .ff-dashboard {
        position: relative;
        overflow: hidden;
        border: 5px solid rgba(255, 255, 255, .10);
        border-radius: 28px;
        background: var(--slate-50);
        box-shadow: 0 40px 100px rgba(0, 0, 0, .40);
        transform: perspective(1400px) rotateY(-4deg) rotateX(2deg);
    }

    .ff-dashboard-header {
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 17px;
        background: var(--green-950);
    }

    .ff-dashboard-brand {
        color: var(--white);
        font-size: 11px;
        font-weight: 900;
    }

        .ff-dashboard-brand i,
        .ff-dashboard-brand span {
            color: var(--green-400);
        }

        .ff-dashboard-brand i {
            margin-right: 5px;
        }

    .ff-dashboard-links {
        display: flex;
        gap: 18px;
    }

        .ff-dashboard-links span {
            color: #94a3b8;
            font-size: 7px;
            font-weight: 700;
        }

    .ff-dashboard-body {
        display: flex;
        min-height: 410px;
    }

    .ff-sidebar {
        width: 145px;
        padding: 15px 10px;
        background: #052e24;
    }

    .ff-user {
        display: flex;
        align-items: center;
        gap: 7px;
        padding-bottom: 14px;
        margin-bottom: 10px;
        border-bottom: 1px solid rgba(255, 255, 255, .08);
    }

    .ff-user-icon {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: var(--white);
        background: var(--green-500);
        font-size: 9px;
    }

    .ff-user strong,
    .ff-user small {
        display: block;
    }

    .ff-user strong {
        color: var(--white);
        font-size: 7px;
    }

    .ff-user small {
        margin-top: 2px;
        color: #94a3b8;
        font-size: 6px;
    }

    .ff-menu-item {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 9px 7px;
        margin-bottom: 2px;
        border-radius: 8px;
        color: #94a3b8;
        font-size: 7px;
        font-weight: 600;
    }

        .ff-menu-item i {
            width: 12px;
            text-align: center;
        }

        .ff-menu-item.active {
            color: var(--white);
            background: rgba(16, 185, 129, .18);
        }

            .ff-menu-item.active i {
                color: var(--green-400);
            }

    .ff-dashboard-content {
        flex: 1;
        padding: 17px;
    }

    .ff-dashboard-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

        .ff-dashboard-title small {
            color: var(--slate-500);
            font-size: 7px;
        }

        .ff-dashboard-title h3 {
            margin: 3px 0 0;
            color: var(--slate-900);
            font-size: 17px;
            font-weight: 800;
        }

        .ff-dashboard-title button {
            padding: 7px 10px;
            border: 0;
            border-radius: 8px;
            color: var(--white);
            background: var(--green-500);
            font-size: 7px;
            font-weight: 700;
        }

    .ff-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 7px;
        margin-bottom: 9px;
    }

    .ff-stat {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 9px;
        border: 1px solid #edf0f2;
        border-radius: 10px;
        background: var(--white);
    }

    .ff-stat-icon {
        width: 25px;
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        color: var(--green-600);
        background: var(--green-50);
        font-size: 9px;
    }

    .ff-stat small,
    .ff-stat strong {
        display: block;
    }

    .ff-stat small {
        color: var(--slate-500);
        font-size: 5px;
    }

    .ff-stat strong {
        color: var(--slate-900);
        font-size: 10px;
    }

    .ff-dashboard-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 8px;
    }

    .ff-dashboard-card {
        padding: 11px;
        border: 1px solid #edf0f2;
        border-radius: 10px;
        background: var(--white);
    }

    .ff-card-title {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

        .ff-card-title strong {
            font-size: 8px;
        }

        .ff-card-title span {
            color: var(--green-600);
            font-size: 6px;
        }

    .ff-chart {
        position: relative;
        height: 110px;
        overflow: hidden;
        border-bottom: 1px solid var(--slate-200);
        background: repeating-linear-gradient( to bottom, transparent, transparent 27px, #f1f5f9 28px );
    }

    .ff-chart-line {
        position: absolute;
        left: -5%;
        width: 110%;
        height: 2px;
        background: var(--green-500);
    }

        .ff-chart-line.one {
            top: 55px;
            transform: rotate(-5deg);
        }

        .ff-chart-line.two {
            top: 73px;
            opacity: .5;
            transform: rotate(5deg);
        }

        .ff-chart-line.three {
            top: 40px;
            opacity: .25;
            transform: rotate(-8deg);
        }

    .ff-agenda {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 10px;
    }

        .ff-agenda span {
            color: var(--slate-500);
            font-size: 6px;
        }

        .ff-agenda div {
            flex: 1;
            height: 5px;
            border-radius: 10px;
            background: var(--slate-200);
        }

        .ff-agenda b {
            color: var(--green-600);
            font-size: 5px;
        }

    .ff-bottom {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 7px;
        margin-top: 8px;
    }

    .ff-bottom-item {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 8px;
        border: 1px solid #edf0f2;
        border-radius: 8px;
        background: var(--white);
    }

        .ff-bottom-item i {
            color: var(--green-600);
            font-size: 9px;
        }

        .ff-bottom-item span {
            font-size: 6px;
            font-weight: 700;
        }

    /* =========================================================
           BENEFÍCIOS
           ========================================================= */

    .ff-benefits {
        position: relative;
        z-index: 5;
        margin-top: -40px;
    }

    .ff-benefits-box {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        padding: 20px;
        border: 1px solid var(--slate-200);
        border-radius: 25px;
        background: var(--white);
        box-shadow: var(--shadow-lg);
    }

    .ff-benefit {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px 20px;
        border-right: 1px solid var(--slate-200);
    }

        .ff-benefit:last-child {
            border-right: none;
        }

    .ff-benefit-icon {
        min-width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--green-200);
        border-radius: 15px;
        color: var(--green-600);
        background: var(--green-50);
    }

    .ff-benefit strong {
        font-size: 14px;
    }

    .ff-benefit p {
        margin: 4px 0 0;
        color: var(--slate-500);
        font-size: 11px;
        line-height: 1.4;
    }

    /* =========================================================
           SEÇÕES
           ========================================================= */

    .ff-section {
        padding: 105px 0;
    }

    .ff-section-white {
        background: var(--white);
    }

    .ff-section-green {
        color: var(--white);
        background: radial-gradient(circle at 90% 10%, rgba(52, 211, 153, .18), transparent 25%), linear-gradient(135deg, var(--green-950), var(--green-900));
    }

    .ff-heading {
        max-width: 780px;
        margin: 0 auto 55px;
        text-align: center;
    }

    .ff-section-green .ff-heading p {
        color: #cbd5e1;
    }

    .ff-label {
        display: inline-block;
        padding: 7px 14px;
        margin-bottom: 14px;
        border-radius: 50px;
        color: var(--green-700);
        background: var(--green-100);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .7px;
    }

    .ff-section-green .ff-label {
        color: var(--green-100);
        background: rgba(52, 211, 153, .12);
        border: 1px solid rgba(52, 211, 153, .20);
    }

    .ff-heading h2 {
        margin: 0 0 15px;
        font-size: clamp(32px, 4vw, 48px);
        line-height: 1.05;
        letter-spacing: -2px;
        font-weight: 900;
    }

        .ff-heading h2 span {
            color: var(--green-600);
        }

    .ff-section-green .ff-heading h2 span {
        color: var(--green-400);
    }

    .ff-heading p {
        margin: 0;
        color: var(--slate-500);
        font-size: 15px;
        line-height: 1.7;
    }

    /* =========================================================
           CARDS
           ========================================================= */

    .ff-card {
        height: 100%;
        padding: 30px;
        border: 1px solid var(--slate-200);
        border-radius: var(--radius-lg);
        background: var(--white);
        box-shadow: var(--shadow-sm);
        transition: .3s ease;
    }

        .ff-card:hover {
            border-color: var(--green-400);
            box-shadow: 0 25px 60px rgba(16, 185, 129, .14);
            transform: translateY(-8px);
        }

    .ff-section-green .ff-card {
        border-color: rgba(255, 255, 255, .10);
        background: rgba(255, 255, 255, .07);
        backdrop-filter: blur(10px);
    }

    .ff-card-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 22px;
        border-radius: 16px;
        color: var(--green-600);
        background: var(--green-50);
        font-size: 20px;
    }

    .ff-section-green .ff-card-icon {
        color: var(--green-900);
        background: var(--green-400);
    }

    .ff-card h3 {
        margin: 0 0 12px;
        color: var(--slate-900);
        font-size: 19px;
        font-weight: 800;
    }

    .ff-section-green .ff-card h3 {
        color: var(--white);
    }

    .ff-card p {
        margin: 0;
        color: var(--slate-500);
        font-size: 14px;
        line-height: 1.7;
    }

    .ff-section-green .ff-card p {
        color: #cbd5e1;
    }

    /* =========================================================
           CONTATO
           ========================================================= */

    .ff-contact {
        padding: 100px 0;
        color: var(--white);
        background: radial-gradient(circle at 15% 50%, rgba(52, 211, 153, .20), transparent 30%), linear-gradient(135deg, var(--green-950), var(--green-900));
    }

    .ff-contact-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 40px;
        padding: 60px;
        border: 1px solid rgba(255, 255, 255, .10);
        border-radius: var(--radius-xl);
        background: rgba(255, 255, 255, .05);
        box-shadow: 0 30px 80px rgba(0, 0, 0, .18);
        backdrop-filter: blur(12px);
    }

    .ff-contact-label {
        color: var(--green-400);
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1px;
    }

    .ff-contact h2 {
        max-width: 650px;
        margin: 10px 0;
        font-size: clamp(30px, 4vw, 42px);
        line-height: 1.05;
        font-weight: 900;
        letter-spacing: -1.5px;
    }

    .ff-contact p {
        margin: 0;
        color: #cbd5e1;
    }

    /* =========================================================
           CHAT
           ========================================================= */

    .ff-chat {
        position: fixed;
        right: 25px;
        bottom: 25px;
        z-index: 1000;
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 50%;
        color: var(--white);
        background: var(--green-500);
        font-size: 21px;
        box-shadow: 0 14px 35px rgba(16, 185, 129, .35);
        transition: .25s;
    }

        .ff-chat:hover {
            color: var(--white);
            background: var(--green-600);
            transform: translateY(-4px) scale(1.03);
        }

    /* =========================================================
           RESPONSIVO
           ========================================================= */

    @@media (max-width: 991px) {

        .ff-hero {
            padding: 110px 0 80px;
        }

        .ff-hero-content {
            padding-right: 0;
        }

        .ff-dashboard-wrapper {
            margin-top: 65px;
        }

        .ff-dashboard {
            transform: none;
        }

        .ff-benefits-box {
            grid-template-columns: repeat(2, 1fr);
        }

        .ff-benefit:nth-child(2) {
            border-right: none;
        }

        .ff-benefit:nth-child(-n+2) {
            border-bottom: 1px solid var(--slate-200);
            padding-bottom: 20px;
        }

        .ff-benefit:nth-child(n+3) {
            padding-top: 20px;
        }
    }

    @@media (max-width: 767px) {

        .ff-hero {
            min-height: auto;
            padding: 100px 0 70px;
        }

        .ff-container {
            padding: 0 20px;
        }

        .ff-hero h1 {
            letter-spacing: -2px;
        }

        .ff-buttons {
            flex-direction: column;
        }

        .ff-btn {
            width: 100%;
        }

        .ff-dashboard-wrapper {
            display: none;
        }

        .ff-benefits {
            margin-top: -20px;
        }

        .ff-benefits-box {
            grid-template-columns: 1fr;
        }

        .ff-benefit {
            border-right: none;
            border-bottom: 1px solid var(--slate-200);
            padding: 18px 10px !important;
        }

            .ff-benefit:last-child {
                border-bottom: none;
            }

        .ff-section {
            padding: 75px 0;
        }

        .ff-heading {
            margin-bottom: 40px;
        }

        .ff-card {
            padding: 25px;
        }

        .ff-contact {
            padding: 70px 0;
        }

        .ff-contact-box {
            flex-direction: column;
            align-items: flex-start;
            padding: 40px 28px;
        }

        .ff-chat {
            right: 18px;
            bottom: 18px;
        }
    }
</style>

<!-- =========================================================
     HERO
     ========================================================= -->

<section class="ff-hero" id="inicio">

  
    <div class="ff-container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <div class="ff-hero-content">

                    <div class="ff-badge">
                        <i class="fa-solid fa-heart-pulse"></i>
                        Plataforma completa para gestão de fisioterapia
                    </div>

                    <div class="ff-hero-small">
                        Você cuida dos seus pacientes.
                    </div>

                    <div class="ff-hero-highlight">
                        O Fisio Flow cuida da gestão.
                    </div>

                    <div class="ff-line"></div>

                    <h1>
                        Sua clínica mais
                        <span>organizada, digital e eficiente.</span>
                    </h1>

                    <p class="ff-hero-description">
                        Uma plataforma completa para clínicas e profissionais
                        de fisioterapia gerenciarem pacientes, avaliações,
                        tratamentos, agenda e informações clínicas em um
                        único ambiente.
                    </p>

                    <div class="ff-buttons">

                        <a href="#recursos" class="ff-btn ff-btn-green">
                            <i class="fa-solid fa-rocket"></i>
                            Conhecer o Fisio Flow
                        </a>

                        <a href="#contato" class="ff-btn ff-btn-outline">
                            <i class="fa-solid fa-headset"></i>
                            Falar com nossa equipe
                        </a>

                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="ff-dashboard-wrapper">

                    <div class="ff-dashboard-glow"></div>

                    <div class="ff-dashboard">

                        <div class="ff-dashboard-header">

                            <div class="ff-dashboard-brand">
                                <i class="fa-solid fa-heart-pulse"></i>
                                FISIO<span>FLOW</span>
                            </div>

                            <div class="ff-dashboard-links">
                                <span>Pacientes</span>
                                <span>Agenda</span>
                                <span>Tratamentos</span>
                                <span>Relatórios</span>
                            </div>

                        </div>


                        <div class="ff-dashboard-body">

                            <aside class="ff-sidebar">

                                <div class="ff-user">

                                    <div class="ff-user-icon">
                                        <i class="fa-solid fa-user-doctor"></i>
                                    </div>

                                    <div>
                                        <strong>FISIOTERAPEUTA</strong>
                                        <small>Usuário logado</small>
                                    </div>

                                </div>

                                <div class="ff-menu-item active">
                                    <i class="fa-solid fa-house"></i>
                                    Início
                                </div>

                                <div class="ff-menu-item">
                                    <i class="fa-solid fa-users"></i>
                                    Pacientes
                                </div>

                                <div class="ff-menu-item">
                                    <i class="fa-solid fa-calendar-days"></i>
