@using System.Security.Claims

<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FisioFlow Admin</title>

    <meta name="description" content="Painel administrativo FisioFlow" />
    <meta name="author" content="FisioFlow" />

    <link rel="icon" type="image/png" href="~/images/favicon.png" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    <style>

        :root {
            --ff-primary: #10b981;
            --ff-primary-dark: #047857;
            --ff-primary-light: #d1fae5;
            --ff-primary-soft: #ecfdf5;

            --ff-secondary: #064e3b;

            --ff-dark: #0f172a;
            --ff-dark-2: #111827;

            --ff-sidebar: #022c22;
            --ff-sidebar-hover: #064e3b;

            --ff-white: #ffffff;

            --ff-bg: #f1f5f9;
            --ff-border: #e2e8f0;

            --ff-text: #1e293b;
            --ff-muted: #64748b;

            --ff-danger: #ef4444;
            --ff-warning: #f59e0b;

            --ff-radius: 16px;

            --ff-sidebar-width: 260px;
            --ff-sidebar-collapsed: 82px;

            --ff-navbar-height: 76px;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            margin: 0;
            background: var(--ff-bg);
            color: var(--ff-text);
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }

        button,
        input {
            font-family: inherit;
        }


        /* =========================================================
           SIDEBAR
        ========================================================= */

        .sidebar-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;

            width: var(--ff-sidebar-width);

            background:
                linear-gradient(
                    180deg,
                    #022c22 0%,
                    #064e3b 55%,
                    #022c22 100%
                );

            color: white;

            display: flex;
            flex-direction: column;

            z-index: 1050;

            box-shadow:
                8px 0 30px rgba(15, 23, 42, .08);

            transition:
                width .3s ease,
                transform .3s ease;
        }


        /* =========================================================
           LOGO
        ========================================================= */

        .sidebar-brand {
            height: var(--ff-navbar-height);

            display: flex;
            align-items: center;

            gap: 12px;

            padding: 0 24px;

            color: white;

            font-size: 21px;
            font-weight: 800;

            letter-spacing: -.4px;

            border-bottom:
                1px solid rgba(255, 255, 255, .08);

            white-space: nowrap;

            overflow: hidden;

            transition:
                padding .3s ease;
        }

        .sidebar-brand:hover {
            color: white;
        }

        .sidebar-brand-icon {
            flex-shrink: 0;

            width: 40px;
            height: 40px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background:
                linear-gradient(
                    135deg,
                    var(--ff-primary),
                    #34d399
                );

            color: white;

            font-size: 21px;

            box-shadow:
                0 8px 20px rgba(16, 185, 129, .25);
        }


        /* =========================================================
           SIDEBAR CONTENT
        ========================================================= */

        .sidebar-content {
            flex: 1;

            overflow-y: auto;

            padding: 20px 14px;
        }

        .sidebar-content::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar-content::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar-content::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, .15);
            border-radius: 10px;
        }


        /* =========================================================
           SIDEBAR SECTIONS
        ========================================================= */

        .sidebar-section {
            margin-bottom: 26px;
        }

        .sidebar-section-title {
            padding: 0 14px;

            margin-bottom: 8px;

            color: rgba(255, 255, 255, .45);

            font-size: 11px;
            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: 1px;

            white-space: nowrap;

            transition: opacity .2s ease;
        }


        /* =========================================================
           SIDEBAR MENU
        ========================================================= */

        .sidebar-menu {
            list-style: none;

            padding: 0;
            margin: 0;
        }

        .sidebar-menu-item {
            margin-bottom: 4px;
        }

        .sidebar-menu-link {
            min-height: 46px;

            display: flex;
            align-items: center;

            gap: 13px;

            padding: 0 14px;

            border-radius: 12px;

            color: rgba(255, 255, 255, .72);

            font-size: 14px;
            font-weight: 500;

            white-space: nowrap;

            overflow: hidden;

            transition:
                background .2s ease,
                color .2s ease,
                transform .2s ease;
        }

        .sidebar-menu-link i {
            width: 20px;

            min-width: 20px;

            text-align: center;

            font-size: 17px;
        }

        .sidebar-menu-link:hover {
            background: rgba(255, 255, 255, .08);

            color: white;

            transform: translateX(2px);
        }

        .sidebar-menu-link.active {
            color: white;

            background:
                linear-gradient(
                    90deg,
                    rgba(16, 185, 129, .95),
                    rgba(5, 150, 105, .85)
                );

            box-shadow:
                0 8px 20px rgba(0, 0, 0, .12);
        }


        /* =========================================================
           SIDEBAR PROFILE
        ========================================================= */

        .sidebar-profile {
            padding: 18px;

            border-top:
                1px solid rgba(255, 255, 255, .08);

            transition:
                padding .3s ease;
        }

        .sidebar-profile-card {
            display: flex;
            align-items: center;

            gap: 11px;

            padding: 12px;

            border-radius: 14px;

            background:
                rgba(255, 255, 255, .06);

            overflow: hidden;
        }

        .sidebar-profile-avatar {
            flex-shrink: 0;

            width: 42px;
            height: 42px;

            border-radius: 12px;

            object-fit: cover;

            background: var(--ff-primary);
        }

        .sidebar-profile-name {
            color: white;

            font-size: 13px;
            font-weight: 700;

            white-space: nowrap;
        }

        .sidebar-profile-role {
            color: rgba(255, 255, 255, .5);

            font-size: 11px;

            margin-top: 2px;

            white-space: nowrap;
        }


        /* =========================================================
           SIDEBAR COLLAPSED
        ========================================================= */

        .sidebar-wrapper.collapsed {
            width: var(--ff-sidebar-collapsed);
        }

        .sidebar-wrapper.collapsed .sidebar-brand {
            justify-content: center;

            padding: 0;

            gap: 0;
        }

        .sidebar-wrapper.collapsed .sidebar-brand > span:last-child {
            display: none;
        }

        .sidebar-wrapper.collapsed .sidebar-section-title {
            display: none;
        }

        .sidebar-wrapper.collapsed .sidebar-menu-link {
            justify-content: center;

            padding-left: 0;
            padding-right: 0;

            gap: 0;
        }

        .sidebar-wrapper.collapsed .sidebar-menu-link span {
            display: none;
        }

        .sidebar-wrapper.collapsed .sidebar-profile {
            padding: 14px 10px;
        }

        .sidebar-wrapper.collapsed .sidebar-profile-card {
            justify-content: center;

            padding: 8px;
        }

        .sidebar-wrapper.collapsed .sidebar-profile-card > div {
            display: none;
        }


        /* =========================================================
           MAIN
        ========================================================= */

        .main-wrapper {
            min-height: 100vh;

            margin-left: var(--ff-sidebar-width);

            transition:
                margin-left .3s ease;
        }

        .main-wrapper.sidebar-collapsed {
            margin-left: var(--ff-sidebar-collapsed);
        }


        /* =========================================================
           NAVBAR
        ========================================================= */

        .navbar-custom {
            position: sticky;

            top: 0;

            z-index: 1000;

            height: var(--ff-navbar-height);

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;

            padding: 0 28px;

            background:
                rgba(255, 255, 255, .94);

            backdrop-filter:
                blur(15px);

            border-bottom:
                1px solid var(--ff-border);
        }

        .navbar-left {
            display: flex;
            align-items: center;

            gap: 12px;
        }

        .navbar-actions {
            display: flex;
            align-items: center;

            gap: 4px;
        }


        /* =========================================================
           MENU TOGGLE
        ========================================================= */

        .menu-toggle-btn {
            width: 42px;
            height: 42px;

            border:
                1px solid var(--ff-border);

            border-radius: 12px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            background: white;

            color: var(--ff-muted);

            cursor: pointer;

            transition:
                all .2s ease;
        }

        .menu-toggle-btn:hover {
            color: var(--ff-primary-dark);

            border-color:
                var(--ff-primary);

            background:
                var(--ff-primary-light);

            transform: translateY(-1px);
        }

        .menu-toggle-btn i {
            font-size: 20px;

            transition:
                transform .3s ease;
        }

        .sidebar-wrapper.collapsed ~ .main-wrapper
        .menu-toggle-btn i {
            transform: rotate(180deg);
        }


        /* =========================================================
           SEARCH
        ========================================================= */

        .navbar-search-wrapper {
            flex: 1;

            max-width: 520px;

            position: relative;

            margin-left: auto;
            margin-right: auto;
        }

        .navbar-search-input {
            width: 100%;

            height: 44px;

            border:
                1px solid var(--ff-border);

            border-radius: 14px;

            padding:
                0 50px 0 18px;

            background: #f8fafc;

            color: var(--ff-text);

            outline: none;

            transition:
                all .2s ease;
        }

        .navbar-search-input::placeholder {
            color: #94a3b8;
        }

        .navbar-search-input:focus {
            background: white;

            border-color:
                var(--ff-primary);

            box-shadow:
                0 0 0 4px rgba(16, 185, 129, .1);
        }

        .navbar-search-btn {
            position: absolute;

            right: 5px;
            top: 5px;

            width: 34px;
            height: 34px;

            border: 0;

            border-radius: 10px;

            background:
                var(--ff-primary);

            color: white;

            cursor: pointer;

            transition:
                all .2s ease;
        }

        .navbar-search-btn:hover {
            background:
                var(--ff-primary-dark);

            transform: scale(1.04);
        }


        /* =========================================================
           NAVBAR ACTIONS
        ========================================================= */

        .navbar-action-btn {
            width: 42px;
            height: 42px;

            border:
                1px solid var(--ff-border);

            border-radius: 12px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            background: white;

            color: var(--ff-muted);

            cursor: pointer;

            transition:
                all .2s ease;
        }

        .navbar-action-btn:hover {
            color:
                var(--ff-primary-dark);

            border-color:
                var(--ff-primary);

            background:
                var(--ff-primary-light);
        }


        /* =========================================================
           PROFILE BUTTON
        ========================================================= */

        .navbar-profile-btn {
            display: flex;
            align-items: center;

            gap: 10px;

            border: 0;

            background: transparent;

            color: var(--ff-text);

            padding: 4px 8px;

            cursor: pointer;
        }

        .navbar-profile-btn::after {
            margin-left: 2px;
        }

        .navbar-profile-img {
            width: 40px;
            height: 40px;

            border-radius: 12px;

            object-fit: cover;

            background:
                var(--ff-primary-light);
        }

        .navbar-profile-name {
            font-size: 13px;
            font-weight: 700;
        }


        /* =========================================================
           DROPDOWN
        ========================================================= */

        .dropdown-menu {
            border-radius: 14px !important;

            overflow: hidden;

            min-width: 210px;
        }

        .dropdown-item {
            padding: 10px 15px;

            font-size: 13px;

            transition:
                background .2s ease;
        }

        .dropdown-item:hover {
            background:
                var(--ff-primary-soft);

            color:
                var(--ff-primary-dark);
        }

        .dropdown-item.text-danger:hover {
            color:
                #dc2626 !important;

            background:
                #fef2f2;
        }


        /* =========================================================
           CONTENT
        ========================================================= */

        .content-wrapper {
            padding: 30px;
        }

        .page-header {
            display: flex;

            align-items: center;
            justify-content: space-between;

            gap: 20px;

            margin-bottom: 28px;
        }

        .page-title {
            margin: 0;

            font-size: 28px;

            font-weight: 800;

            letter-spacing: -.7px;

            color: var(--ff-dark);
        }

        .page-subtitle {
            margin: 6px 0 0;

            color: var(--ff-muted);

            font-size: 14px;
        }

        .admin-badge {
            display: inline-flex;

            align-items: center;

            gap: 7px;

            padding: 8px 13px;

            border-radius: 999px;

            background:
                var(--ff-primary-light);

            color:
                var(--ff-primary-dark);

            font-size: 12px;

            font-weight: 700;

            white-space: nowrap;
        }


        /* =========================================================
           DASHBOARD CARDS
        ========================================================= */

        .dashboard-card {
            height: 100%;

            padding: 22px;

            border:
                1px solid var(--ff-border);

            border-radius:
                var(--ff-radius);

            background: white;

            box-shadow:
                0 8px 25px rgba(15, 23, 42, .04);

            transition:
                transform .2s ease,
                box-shadow .2s ease;
        }

        .dashboard-card:hover {
            transform:
                translateY(-2px);

            box-shadow:
                0 15px 35px rgba(15, 23, 42, .07);
        }

        .stat-icon {
            width: 48px;
            height: 48px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 14px;

            background:
                var(--ff-primary-light);

            color:
                var(--ff-primary-dark);

            font-size: 21px;
        }

        .stat-label {
            color:
                var(--ff-muted);

            font-size: 13px;

            font-weight: 600;
        }

        .stat-value {
            margin-top: 5px;

            font-size: 28px;

            font-weight: 800;

            color:
                var(--ff-dark);
        }

        .stat-description {
            margin-top: 5px;

            color:
                var(--ff-muted);

            font-size: 12px;
        }

        .dashboard-card-header {
            display: flex;

            align-items: center;
            justify-content: space-between;

            margin-bottom: 20px;
        }

        .dashboard-card-title {
            margin: 0;

            font-size: 17px;

            font-weight: 750;
        }

        .dashboard-card-subtitle {
            margin: 4px 0 0;

            color:
                var(--ff-muted);

            font-size: 12px;
        }


        /* =========================================================
           QUICK ACTIONS
        ========================================================= */

        .quick-action {
            display: flex;

            align-items: center;

            gap: 13px;

            padding: 16px;

            border:
                1px solid var(--ff-border);

            border-radius: 14px;

            color:
                var(--ff-text);

            background: white;

            transition:
                all .2s ease;
        }

        .quick-action:hover {
            border-color:
                var(--ff-primary);

            background:
                var(--ff-primary-light);

            color:
                var(--ff-primary-dark);
        }

        .quick-action-icon {
            width: 42px;
            height: 42px;

            flex-shrink: 0;

            border-radius: 12px;

            display: flex;
            align-items: center;
            justify-content: center;

            background:
                var(--ff-primary-light);

            color:
                var(--ff-primary-dark);

            font-size: 18px;
        }


        /* =========================================================
           FOOTER
        ========================================================= */

            .footer-custom {
                flex-shrink: 0;
                padding: 20px 30px;
                border-top: 1px solid var(--ff-border);
                background: white;
                color: var(--ff-muted);
                font-size: 12px;
            }


        /* =========================================================
           OVERLAY
        ========================================================= */

        .sidebar-overlay {
            position: fixed;

            inset: 0;

            background:
                rgba(15, 23, 42, .45);

            z-index: 1040;

            display: none;
        }

        .sidebar-overlay.show {
            display: block;
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>


<body>


    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside class="sidebar-wrapper" id="sidebar">


        <!-- LOGO -->

        <a asp-area="Admin"
           asp-controller="Home"
           asp-action="Index"
           class="sidebar-brand">

            <span class="sidebar-brand-icon">

                <i class="bi bi-heart-pulse-fill"></i>

            </span>

            <span>

                FisioFlow

            </span>

        </a>


        <!-- MENU -->

        <div class="sidebar-content">


            <!-- PRINCIPAL -->

            <div class="sidebar-section">

                <div class="sidebar-section-title">

                    Principal

                </div>

                <ul class="sidebar-menu">

                    <li class="sidebar-menu-item">

                        <a asp-area="Admin"
                           asp-controller="Admin"
                           asp-action="Index"
                           class="sidebar-menu-link">

                            <i class="bi bi-grid-1x2-fill"></i>

                            <span>

                                Dashboard

                            </span>

                        </a>

                    </li>

                </ul>

            </div>


            <!-- GESTÃO -->

            <div class="sidebar-section">

                <div class="sidebar-section-title">

                    Gestão

                </div>

                <ul class="sidebar-menu">


                    <li class="sidebar-menu-item">

                          <a asp-area="Admin"
                           asp-controller="Patients"
                           asp-action="Index"
                           class="sidebar-menu-link">

                            <i class="bi bi-people-fill"></i>

                            <span>

                                Pacientes

                            </span>

                        </a>

                    </li>


                    <li class="sidebar-menu-item">

                        <a asp-area="Admin"
                           asp-controller="Physiotherapists"
                           asp-action="Index"
                           class="sidebar-menu-link">

                            <i class="bi bi-person-badge-fill"></i>

                            <span>

                                Fisioterapeutas

                            </span>

                        </a>

                    </li>


                    <li class="sidebar-menu-item">

                          <a asp-area="Admin"
                           asp-controller="Sessions"
                           asp-action="Index"
                           class="sidebar-menu-link">

                            <i class="bi bi-calendar2-check-fill"></i>

                            <span>

                                Agendamentos

                            </span>

                        </a>

                    </li>


                    <li class="sidebar-menu-item">

                        <a href="#"
                           class="sidebar-menu-link">

                            <i class="bi bi-clipboard2-pulse-fill"></i>

                            <span>

                                Atendimentos

                            </span>

                        </a>

                    </li>

                </ul>

            </div>


            <!-- SISTEMA -->

            <div class="sidebar-section">

                <div class="sidebar-section-title">

                    Sistema

                </div>

                <ul class="sidebar-menu">


                    <li class="sidebar-menu-item">

                        <a href="#"
                           class="sidebar-menu-link">

                            <i class="bi bi-person-gear"></i>

                            <span>

                                Usuários

                            </span>

                        </a>

                    </li>


                    <li class="sidebar-menu-item">

                        <a href="#"
                           class="sidebar-menu-link">

                            <i class="bi bi-shield-lock-fill"></i>

                            <span>

                                Permissões

                            </span>

                        </a>

                    </li>


                    <li class="sidebar-menu-item">

                        <a href="#"
                           class="sidebar-menu-link">

                            <i class="bi bi-gear-fill"></i>

                            <span>

                                Configurações

                            </span>

                        </a>

                    </li>

                </ul>

            </div>

        </div>


        <!-- =====================================================
             PERFIL
        ====================================================== -->

        <div class="sidebar-profile">

            <div class="sidebar-profile-card">


                <img src="~/images/avatar.png"
                     alt="Usuário"
                     class="sidebar-profile-avatar"
                     onerror="this.style.display='none';" />


                <div>

                    <div class="sidebar-profile-name">

                        @(User.Identity?.Name ?? "Administrador")

                    </div>

                    <div class="sidebar-profile-role">

                        Administrador

                    </div>

                </div>

            </div>

        </div>

    </aside>


    <!-- OVERLAY MOBILE -->

    <div class="sidebar-overlay"
         id="sidebar-overlay">
    </div>


    <!-- =========================================================
         MAIN
    ========================================================== -->

    <div class="main-wrapper" id="main-wrapper">


        <!-- =====================================================
             NAVBAR
        ====================================================== -->

        <header class="navbar-custom">


            <!-- MENU -->

            <div class="navbar-left">

                <button type="button"
                        class="menu-toggle-btn"
                        id="menu-toggle"
                        aria-label="Abrir ou fechar menu"
                        title="Abrir ou fechar menu">

                    <i class="bi bi-list"></i>

                </button>

            </div>


            <!-- PESQUISA -->

            <div class="navbar-search-wrapper">

                <input type="text"
                       class="navbar-search-input"
                       id="main-search"
                       placeholder="Pesquisar no FisioFlow..."
                       autocomplete="off" />

                <button type="button"
                        class="navbar-search-btn"
                        aria-label="Pesquisar">

                    <i class="bi bi-search"></i>

                </button>

            </div>


            <!-- AÇÕES -->

            <div class="navbar-actions">


                <!-- NOTIFICAÇÕES -->

                <div class="dropdown me-2">

                    <button class="navbar-action-btn position-relative"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            title="Notificações">

                        <i class="bi bi-bell"></i>

                    </button>


                    <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0"
                         style="width: 320px;">


                        <div class="p-3 border-bottom">

                            <strong>

                                Notificações

                            </strong>

                        </div>


                        <div class="p-3 text-muted small">

                            Nenhuma nova notificação.

                        </div>

                    </div>

                </div>


                <!-- PERFIL -->

                <div class="dropdown">


                    <button class="navbar-profile-btn dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">


                        <img src="~/images/avatar.png"
                             alt="Perfil"
                             class="navbar-profile-img"
                             onerror="this.style.display='none';" />


                        <span class="navbar-profile-name">

                            @(User.Identity?.Name ?? "Administrador")

                        </span>

                    </button>


                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">


                        <!-- CABEÇALHO -->

                        <li>

                            <div class="dropdown-header">

                                <strong>

                                    Minha conta

                                </strong>

                                <br />

                                <small class="text-muted">

                                    Administrador

                                </small>

                            </div>

                        </li>


                        <li>

                            <hr class="dropdown-divider" />

                        </li>


                        <!-- PERFIL -->

                        <li>

                            <a href="#"
