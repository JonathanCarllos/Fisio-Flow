@model FisioFlow_Web.Areas.Admin.Models.SessionViewModel


@{
    ViewData["Title"] = "Nova Sessão";
}



<div class="container-fluid px-4">


<h1 class="mt-4 mb-4 text-success">

    <i class="fa-solid fa-calendar-plus"></i>

    Nova Sessão

</h1>




<div class="card shadow-sm border-0 rounded-4">


<div class="card-body p-4">



<form asp-action="Create" method="post">


@Html.AntiForgeryToken()



<div class="row">



<!-- Paciente -->

<div class="col-md-6 mb-3">

<label class="form-label fw-bold">

Paciente

</label>


<select asp-for="PatientId"
        class="form-select">


<option value="">
Selecione o paciente
</option>


@foreach(var patient in Model.Patients)
{

<option value="@patient.PatientId">

@patient.Name

</option>

}


</select>


<span asp-validation-for="PatientId"
      class="text-danger"></span>


</div>






<!-- Fisioterapeuta -->

<div class="col-md-6 mb-3">


<label class="form-label fw-bold">

Fisioterapeuta

</label>


<select asp-for="PhysiotherapistId"
        class="form-select">


<option value="">
Selecione o fisioterapeuta
</option>



@foreach(var phy in Model.Physiotherapists)
{


<option value="@phy.PhysiotherapistId">

@phy.Name

</option>


}


</select>


<span asp-validation-for="PhysiotherapistId"
      class="text-danger"></span>


</div>




</div>






<div class="row">


<div class="col-md-4 mb-3">


<label class="form-label fw-bold">

Data

</label>


<input asp-for="Date"
       type="date"
       class="form-control" />


<span asp-validation-for="Date"
      class="text-danger"></span>


</div>





<div class="col-md-4 mb-3">


<label class="form-label fw-bold">

Horário

</label>


<input asp-for="Time"
       type="time"
       class="form-control" />


<span asp-validation-for="Time"
      class="text-danger"></span>


</div>





<div class="col-md-4 mb-3">


<label class="form-label fw-bold">

Duração (minutos)

</label>


<input asp-for="Duration"
       class="form-control"
       value="60"/>


<span asp-validation-for="Duration"
      class="text-danger"></span>


</div>



</div>





<div class="mb-3">


<label class="form-label fw-bold">

Observações

</label>


<textarea asp-for="Notes"
          class="form-control"
          rows="4"></textarea>



</div>






<div class="d-flex justify-content-end gap-2">


<a asp-action="Index"
   class="btn btn-secondary">


<i class="fa-solid fa-arrow-left"></i>

Voltar


</a>




<button type="submit"
        class="btn btn-success">


<i class="fa-solid fa-save"></i>

Salvar Sessão


</button>



</div>





</form>


</div>


</div>


</div>





@section Scripts {


<partial name="_ValidationScriptsPartial" />


}