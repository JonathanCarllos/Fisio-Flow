@model FisioFlow_Web.Areas.Admin.Models.SessionViewModel

@{
    ViewData["Title"] = "Editar Sessão";
}


<div class="container-fluid px-4">


<div class="d-flex justify-content-between align-items-center mb-4">


<h2 class="fw-bold text-success">

<i class="bi bi-calendar-check"></i>

Editar Sessão

</h2>


<a asp-action="Details"
   asp-route-id="@Model.SessionId"
   class="btn btn-secondary">

<i class="bi bi-arrow-left"></i>

Voltar

</a>


</div>




<form asp-action="Edit" method="post">


<input asp-for="SessionId" type="hidden"/>



<div class="card shadow border-0 rounded-4">


<div class="card-body">


<div class="row g-4">



<!-- PACIENTE -->

<div class="col-md-6">

<label class="fw-bold">
Paciente
</label>


<select asp-for="PatientId"
        class="form-select"
        asp-items="@(new SelectList(Model.Patients,
        "PatientId",
        "Name"))">

<option value="">
Selecione o paciente
</option>

</select>


</div>





<!-- FISIOTERAPEUTA -->


<div class="col-md-6">


<label class="fw-bold">
Fisioterapeuta
</label>


<select asp-for="PhysiotherapistId"
        class="form-select"
        asp-items="@(new SelectList(Model.Physiotherapists,
        "PhysiotherapistId",
        "Name"))">


<option value="">
Selecione o fisioterapeuta
</option>


</select>


</div>





<!-- DATA -->


<div class="col-md-4">


<label class="fw-bold">
Data
</label>


<input asp-for="Date"
       type="date"
       class="form-control"/>


</div>





<!-- HORARIO -->


<div class="col-md-4">


<label class="fw-bold">
Horário
</label>


<input asp-for="Time"
       type="time"
       class="form-control"/>


</div>






<!-- DURACAO -->


<div class="col-md-4">


<label class="fw-bold">
Duração (minutos)
</label>


<input asp-for="Duration"
       type="number"
       class="form-control"
       min="1"/>


</div>







<!-- STATUS -->


<div class="col-md-4">


<label class="fw-bold">
Status da sessão
</label>


<select asp-for="Status"
        class="form-select">


<option value="1">
Agendada
</option>


<option value="2">
Compareceu
</option>


<option value="3">
Cancelada
</option>


</select>


</div>







<div class="col-md-12">


<label class="fw-bold">

Observações

</label>


<textarea asp-for="Notes"
          class="form-control"
          rows="3">
</textarea>


</div>








<div class="col-md-12">


<label class="fw-bold">

Evolução

</label>


<textarea asp-for="Evolution"
          class="form-control"
          rows="5">
</textarea>


</div>




</div>




<div class="mt-4">


<button class="btn btn-success px-4">


<i class="bi bi-save"></i>

Salvar alterações


</button>



<a asp-action="Index"
class="btn btn-outline-secondary ms-2">


Cancelar


</a>


</div>



</div>


</div>



</form>



</div>