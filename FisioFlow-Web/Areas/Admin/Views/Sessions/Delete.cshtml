@model FisioFlow_Web.Areas.Admin.Models.SessionViewModel


@{
    ViewData["Title"]="Excluir Sessão";
}



<div class="container-fluid px-4">


<div class="card shadow border-danger rounded-4">


<div class="card-body text-center p-5">


<i class="bi bi-exclamation-triangle text-danger"
style="font-size:60px"></i>



<h2 class="mt-3">

Excluir sessão?

</h2>



<p>

Paciente:

<strong>
@Model.PatientName
</strong>

<br/>

Data:

<strong>
@Model.Date.ToString("dd/MM/yyyy")
</strong>

</p>



<form asp-action="DeleteConfirmed">


<input asp-for="SessionId" type="hidden"/>



<button class="btn btn-danger">

<i class="bi bi-trash"></i>

Confirmar exclusão

</button>



<a asp-action="Details"
asp-route-id="@Model.SessionId"
class="btn btn-secondary">


Cancelar


</a>


</form>


</div>


</div>


</div>
