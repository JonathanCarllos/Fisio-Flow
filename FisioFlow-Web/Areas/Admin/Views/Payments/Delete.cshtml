@model FisioFlow_Web.Areas.Admin.Models.PaymentViewModel

@using FisioFlow_Web.Enums

@{
    ViewData["Title"] = "Excluir Pagamento";


    string GetPaymentMethod(PaymentMethod method)
    {
        return method switch
        {
            PaymentMethod.Cash => "Dinheiro",
            PaymentMethod.CreditCard => "Cartão de Crédito",
            PaymentMethod.DebitCard => "Cartão de Débito",
            PaymentMethod.Pix => "PIX",
            PaymentMethod.BankTransfer => "Transferência Bancária",
            _ => "Não informado"
        };
    }



    string GetStatus(Status status)
    {
        return status switch
        {
            Status.Pending => "Pendente",
            Status.Paid => "Pago",
            Status.Overdue => "Em atraso",
            Status.Cancelled => "Cancelado",
            _ => "Não informado"
        };
    }

}



<div class="container-fluid">



    <div class="d-flex justify-content-between align-items-center mb-4">



        <div>


            <h2 class="fw-bold text-danger mb-1">


                <i class="bi bi-trash"></i>


                Excluir Pagamento


            </h2>



            <p class="text-muted mb-0">


                Confirme a exclusão deste pagamento.


            </p>


        </div>




        <a asp-action="Index"
           class="btn btn-outline-secondary">


            <i class="bi bi-arrow-left"></i>


            Voltar


        </a>



    </div>








    <div class="card shadow-sm border-0">


        <div class="card-body p-4">



            <div class="alert alert-warning d-flex align-items-center">


                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>


                <div>


                    <strong>Atenção!</strong>


                    Esta ação não poderá ser desfeita.


                </div>


            </div>







            <div class="row g-3">



                <div class="col-md-4">


                    <label class="fw-semibold">
                        Valor
                    </label>


                    <div class="form-control bg-light">

                        @Model.Amount.ToString("C2")

                    </div>


                </div>







                <div class="col-md-4">


                    <label class="fw-semibold">
                        Paciente
                    </label>


                    <div class="form-control bg-light">


                        @Model.PatientName


                    </div>


                </div>







                <div class="col-md-4">


                    <label class="fw-semibold">
                        Tratamento
                    </label>


                    <div class="form-control bg-light">


                        @Model.TreatmentName


                    </div>


                </div>








                <div class="col-md-4">


                    <label class="fw-semibold">
                        Método
                    </label>


                    <div class="form-control bg-light">


                        @GetPaymentMethod(Model.PaymentMethod)


                    </div>


                </div>







                <div class="col-md-4">


                    <label class="fw-semibold">
                        Status
                    </label>


                    <div class="form-control bg-light">


                        @GetStatus(Model.Status)


                    </div>


                </div>







                <div class="col-md-4">


                    <label class="fw-semibold">
                        Data Pagamento
                    </label>


                    <div class="form-control bg-light">


                        @Model.PaymentDate?.ToString("dd/MM/yyyy")


                    </div>


                </div>




            </div>







            <div class="mt-4 d-flex justify-content-end gap-2">



                <a asp-action="Index"
                   class="btn btn-outline-secondary">


                    Cancelar


                </a>





                <button type="button"
                        class="btn btn-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteModal">


                    <i class="bi bi-trash"></i>


                    Excluir Pagamento


                </button>



            </div>



        </div>


    </div>




</div>








<!-- MODAL -->



<div class="modal fade"
     id="deleteModal"
     tabindex="-1">



    <div class="modal-dialog modal-dialog-centered">



        <div class="modal-content">



            <div class="modal-header bg-danger text-white">



                <h5 class="modal-title">


                    <i class="bi bi-exclamation-triangle"></i>


                    Confirmar exclusão


                </h5>



                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>



            </div>





            <div class="modal-body">


                Tem certeza que deseja excluir este pagamento?


                <br />


                <strong>
                    Valor:
                    @Model.Amount.ToString("C2")
                </strong>


            </div>






            <div class="modal-footer">



                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">


                    Cancelar


                </button>






                <form asp-action="Delete"
                      method="post">



                    <input type="hidden"
                           asp-for="PaymentId" />



                    <button type="submit"
                            class="btn btn-danger">


                        <i class="bi bi-trash"></i>


                        Confirmar Exclusão


                    </button>



                </form>



            </div>



        </div>


    </div>


</div>