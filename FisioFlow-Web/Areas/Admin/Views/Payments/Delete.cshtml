@model FisioFlow_Web.Areas.Admin.Models.PaymentViewModel

@{
    ViewData["Title"] = "Excluir Pagamento";
}


<div class="container-fluid">


<h2 class="fw-bold text-danger mb-4">

<i class="bi bi-trash"></i>
Excluir Pagamento

</h2>



<div class="card shadow-sm border-danger">


<div class="card-body">


<h5>
Deseja realmente excluir este pagamento?
</h5>


<hr/>


<p>
<strong>Método:</strong>
@Model.PaymentMethod
</p>


<p>
<strong>Paciente:</strong>
@Model.PatientId
</p>


<p>
<strong>Tratamento:</strong>
@Model.TreatmentId
</p>



<form asp-action="Delete"
method="post">


<input asp-for="PaymentId"
type="hidden"/>



<button type="submit"
class="btn btn-danger">

<i class="bi bi-trash"></i>
Excluir

</button>



<a asp-action="Index"
class="btn btn-secondary">

Cancelar

</a>



</form>



</div>


</div>


</div>