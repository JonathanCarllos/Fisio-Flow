@model IEnumerable<FisioFlow_Web.Areas.Admin.Models.PaymentViewModel>

@using FisioFlow_Web.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Pagamentos";

    var culture = new CultureInfo("pt-BR");

    var totalRecebido = Model
        .Where(x => x.Status == Status.Paid)
        .Sum(x => x.Amount);

    var totalPendente = Model
        .Where(x => x.Status != Status.Paid)
        .Sum(x => x.Amount);

    var quantidadePagamentos = Model.Count();
}


<div class="container-fluid">


    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">


        <div>

            <h2 class="fw-bold text-success mb-1">

                <i class="bi bi-wallet2"></i>

                Pagamentos

            </h2>


            <span class="text-muted">

                Gerencie os pagamentos dos tratamentos.

            </span>


        </div>



        <a asp-action="Create"
           class="btn btn-success px-4">

            <i class="bi bi-plus-circle"></i>

            Novo Pagamento

        </a>


    </div>





    <!-- CARDS -->


    <div class="row g-4 mb-4">



        <!-- Recebido -->

        <div class="col-md-4">


            <div class="card border-0 shadow-sm h-100">


                <div class="card-body d-flex align-items-center">


                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">

                        <i class="bi bi-cash-stack text-success fs-3"></i>

                    </div>



                    <div>


                        <span class="text-muted small">

                            Total recebido

                        </span>


                        <h4 class="fw-bold mb-0 text-success">


                            @(totalRecebido.ToString("C2", culture))


                        </h4>


                    </div>


                </div>


            </div>


        </div>





        <!-- Pendentes -->

        <div class="col-md-4">


            <div class="card border-0 shadow-sm h-100">


                <div class="card-body d-flex align-items-center">


                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">

                        <i class="bi bi-clock-history text-warning fs-3"></i>

                    </div>



                    <div>


                        <span class="text-muted small">

                            Valores pendentes

                        </span>


                        <h4 class="fw-bold mb-0">


                            @(totalPendente.ToString("C2", culture))


                        </h4>


                    </div>


                </div>


            </div>


        </div>







        <!-- Quantidade -->

        <div class="col-md-4">


            <div class="card border-0 shadow-sm h-100">


                <div class="card-body d-flex align-items-center">


                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">

                        <i class="bi bi-receipt text-primary fs-3"></i>

                    </div>



                    <div>


                        <span class="text-muted small">

                            Quantidade de pagamentos

                        </span>


                        <h4 class="fw-bold mb-0">

                            @quantidadePagamentos

                        </h4>


                    </div>


                </div>


            </div>


        </div>



    </div>









    @if (!Model.Any())
    {


        <div class="card shadow-sm border-0">


            <div class="card-body text-center py-5">


                <i class="bi bi-wallet2 text-muted"
                   style="font-size:60px">
                </i>



                <h4 class="mt-3">

                    Nenhum pagamento cadastrado

                </h4>


                <p class="text-muted">

                    Comece cadastrando um novo pagamento.

                </p>



                <a asp-action="Create"
                   class="btn btn-success">


                    Criar pagamento


                </a>


            </div>


        </div>


    }
    else
    {



        <!-- TABELA -->


        <div class="card shadow-sm border-0">


            <div class="card-body">


                <div class="table-responsive">


                    <table class="table align-middle table-hover">


                        <thead class="table-light">


                            <tr>


                                <th>
                                    Paciente
                                </th>


                                <th>
                                    Tratamento
                                </th>


                                <th>
                                    Valor
                                </th>


                                <th>
                                    Método
                                </th>


                                <th>
                                    Vencimento
                                </th>


                                <th>
                                    Status
                                </th>


                                <th class="text-center">
                                    Ações
                                </th>


                            </tr>


                        </thead>




                        <tbody>


                            @foreach (var payment in Model)
                            {


                                <tr>


                                    <td>


                                        <div class="fw-semibold">

                                            @payment.PatientName

                                        </div>


                                    </td>





                                    <td>

                                        @payment.TreatmentName

                                    </td>





                                    <td>


                                        <span class="fw-bold text-success">

                                            @payment.Amount.ToString("C2", culture)

                                        </span>


                                    </td>





                                    <td>


                                        @switch (payment.PaymentMethod)
                                        {

                                            case PaymentMethod.Pix:

                                                <span class="badge rounded-pill bg-success">
                                                    PIX
                                                </span>

                                                break;


                                            case PaymentMethod.CreditCard:

                                                <span class="badge rounded-pill bg-primary">
                                                    Cartão
                                                </span>

                                                break;


                                            case PaymentMethod.DebitCard:

                                                <span class="badge rounded-pill bg-info">
                                                    Débito
                                                </span>

                                                break;


                                            case PaymentMethod.Cash:

                                                <span class="badge rounded-pill bg-secondary">
                                                    Dinheiro
                                                </span>

                                                break;


                                            default:

                                                <span class="badge rounded-pill bg-dark">
                                                    Outro
                                                </span>

                                                break;

                                        }


                                    </td>






                                    <td>

                                        @payment.DueDate?.ToString("dd/MM/yyyy")

                                    </td>







                                    <td>


                                        @switch (payment.Status)
                                        {

                                            case Status.Paid:

                                                <span class="badge rounded-pill bg-success">

                                                    Pago

                                                </span>

                                                break;



                                            case Status.Pending:

                                                <span class="badge rounded-pill bg-warning text-dark">

                                                    Pendente

                                                </span>

                                                break;



                                            case Status.Cancelled:

                                                <span class="badge rounded-pill bg-danger">

                                                    Cancelado

                                                </span>

                                                break;



                                            default:

                                                <span class="badge rounded-pill bg-secondary">

                                                    @payment.Status

                                                </span>

                                                break;

                                        }


                                    </td>






                                    <td class="text-center">


                                        <div class="btn-group">


                                            <a asp-action="Details"
                                               asp-route-id="@payment.PaymentId"
                                               class="btn btn-sm btn-outline-success"
                                               title="Detalhes">

                                                <i class="bi bi-eye"></i>

                                            </a>




                                            <a asp-action="Edit"
                                               asp-route-id="@payment.PaymentId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar">

                                                <i class="bi bi-pencil"></i>

                                            </a>




                                            <a asp-action="Delete"
                                               asp-route-id="@payment.PaymentId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Excluir">

                                                <i class="bi bi-trash"></i>

                                            </a>


                                        </div>


                                    </td>



                                </tr>


                            }


                        </tbody>


                    </table>


                </div>


            </div>


        </div>



    }


</div>