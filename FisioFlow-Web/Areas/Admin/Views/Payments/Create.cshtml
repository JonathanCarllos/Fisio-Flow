@model FisioFlow_Web.Areas.Admin.Models.PaymentViewModel

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Novo Pagamento";

    var patients = ViewBag.Patients as SelectList;
    var treatments = ViewBag.Treatments as SelectList;
}



<div class="container-fluid">


    <div class="d-flex justify-content-between align-items-center mb-4">


        <div>

            <h2 class="fw-bold text-success mb-1">

                <i class="bi bi-cash-coin"></i>

                Novo Pagamento

            </h2>


            <p class="text-muted mb-0">

                Cadastre um pagamento relacionado ao tratamento do paciente.

            </p>


        </div>



        <a asp-action="Index"
           class="btn btn-outline-secondary">


            <i class="bi bi-arrow-left"></i>

            Voltar


        </a>


    </div>





    <div class="card shadow-sm border-0">


        <div class="card-body p-4">


            <form asp-action="Create"
                  method="post">



                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>





                <div class="row g-3">





                    <!-- Valor -->


                    <div class="col-md-4">


                        <label asp-for="Amount"
                               class="form-label fw-semibold">
                        </label>


                        <div class="input-group">


                            <span class="input-group-text">
                                R$
                            </span>


                            <input asp-for="Amount"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   placeholder="0,00" />


                        </div>


                        <span asp-validation-for="Amount"
                              class="text-danger">
                        </span>


                    </div>








                    <!-- Paciente -->


                    <div class="col-md-4">


                        <label asp-for="PatientId"
                               class="form-label fw-semibold">
                        </label>



                        <select asp-for="PatientId"
                                class="form-select"
                                asp-items="patients">


                            <option value="">
                                Selecione o paciente
                            </option>


                        </select>



                        <span asp-validation-for="PatientId"
                              class="text-danger">
                        </span>


                    </div>








                    <!-- Tratamento -->


                    <div class="col-md-4">


                        <label asp-for="TreatmentId"
                               class="form-label fw-semibold">
                        </label>



                        <select asp-for="TreatmentId"
                                class="form-select"
                                asp-items="treatments">


                            <option value="">
                                Selecione o tratamento
                            </option>


                        </select>



                        <span asp-validation-for="TreatmentId"
                              class="text-danger">
                        </span>


                    </div>








                    <!-- Método Pagamento -->


                    <div class="col-md-4">


                        <label asp-for="PaymentMethod"
                               class="form-label fw-semibold">
                        </label>



                        <select asp-for="PaymentMethod"
                                class="form-select">


                            <option value="">
                                Selecione o método
                            </option>


                            <option value="1">
                                Dinheiro
                            </option>


                            <option value="2">
                                Cartão de Crédito
                            </option>


                            <option value="3">
                                Cartão de Débito
                            </option>


                            <option value="4">
                                PIX
                            </option>


                            <option value="5">
                                Transferência Bancária
                            </option>


                        </select>



                        <span asp-validation-for="PaymentMethod"
                              class="text-danger">
                        </span>


                    </div>








                    <!-- Status -->


                    <div class="col-md-4">


                        <label asp-for="Status"
                               class="form-label fw-semibold">
                        </label>



                        <select asp-for="Status"
                                class="form-select">


                            <option value="">
                                Selecione o status
                            </option>


                            <option value="1">
                                Pendente
                            </option>


                            <option value="2">
                                Pago
                            </option>


                            <option value="3">
                                Em atraso
                            </option>


                            <option value="4">
                                Cancelado
                            </option>


                        </select>



                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>


                    </div>








                    <!-- Data Pagamento -->


                    <div class="col-md-4">


                        <label asp-for="PaymentDate"
                               class="form-label fw-semibold">
                        </label>



                        <input asp-for="PaymentDate"
                               class="form-control"
                               type="date" />



                        <span asp-validation-for="PaymentDate"
                              class="text-danger">
                        </span>


                    </div>








                    <!-- Vencimento -->


                    <div class="col-md-4">


                        <label asp-for="DueDate"
                               class="form-label fw-semibold">
                        </label>



                        <input asp-for="DueDate"
                               class="form-control"
                               type="date" />



                        <span asp-validation-for="DueDate"
                              class="text-danger">
                        </span>


                    </div>








                    <!-- Convênio -->


                    <div class="col-md-4">


                        <label asp-for="InsuranceName"
                               class="form-label fw-semibold">
                        </label>



                        <input asp-for="InsuranceName"
                               class="form-control"
                               placeholder="Nome do convênio" />



                        <span asp-validation-for="InsuranceName"
                              class="text-danger">
                        </span>


                    </div>








                    <!-- Descrição -->


                    <div class="col-md-12">


                        <label asp-for="Description"
                               class="form-label fw-semibold">
                        </label>



                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Observações do pagamento">
                        </textarea>



                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>


                    </div>



                </div>







                <div class="mt-4 d-flex justify-content-end gap-2">



                    <a asp-action="Index"
                       class="btn btn-outline-secondary">


                        <i class="bi bi-x-circle"></i>

                        Cancelar


                    </a>





                    <button type="submit"
                            class="btn btn-success">


                        <i class="bi bi-check-circle"></i>

                        Salvar Pagamento


                    </button>


                </div>



            </form>


        </div>


    </div>


</div>





@section Scripts
{

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}