@model FisioFlow_Web.Areas.Admin.Models.PaymentViewModel

@{
    ViewData["Title"] = "Editar Pagamento";
}


<div class="container-fluid">


<div class="d-flex justify-content-between align-items-center mb-4">

<h2 class="fw-bold text-success">
<i class="bi bi-pencil"></i>
Editar Pagamento
</h2>


<a asp-action="Index" class="btn btn-outline-secondary">
<i class="bi bi-arrow-left"></i>
Voltar
</a>


</div>




<div class="card shadow-sm border-0">


<div class="card-header bg-success text-white">

<h5 class="mb-0">
Atualização do Pagamento
</h5>

</div>



<div class="card-body">


<form asp-action="Edit" method="post">


<input asp-for="PaymentId" type="hidden" />


<div asp-validation-summary="ModelOnly"
     class="alert alert-danger">
</div>



<div class="row">


<div class="col-md-6 mb-3">

<label asp-for="PaymentMethod"
       class="form-label"></label>


<select asp-for="PaymentMethod"
        class="form-select"
        asp-items="Html.GetEnumSelectList<FisioFlow_Web.Enums.PaymentMethod>()">

<option value="">
Selecione
</option>

</select>


<span asp-validation-for="PaymentMethod"
      class="text-danger"></span>


</div>



<div class="col-md-3 mb-3">

<label asp-for="PaymentDate"
class="form-label"></label>


<input asp-for="PaymentDate"
class="form-control"
type="date"/>


</div>




<div class="col-md-3 mb-3">

<label asp-for="DueDate"
class="form-label"></label>


<input asp-for="DueDate"
class="form-control"
type="date"/>


</div>


</div>





<div class="row">


<div class="col-md-6 mb-3">

<label asp-for="InsuranceName"
class="form-label"></label>


<input asp-for="InsuranceName"
class="form-control"/>


</div>



<div class="col-md-6 mb-3">

<label asp-for="Description"
class="form-label"></label>


<textarea asp-for="Description"
class="form-control">
</textarea>


</div>


</div>





<div class="row">


<div class="col-md-6 mb-3">

<label asp-for="PatientId"
class="form-label"></label>


<input asp-for="PatientId"
class="form-control"/>


</div>



<div class="col-md-6 mb-3">

<label asp-for="TreatmentId"
class="form-label"></label>


<input asp-for="TreatmentId"
class="form-control"/>


</div>


</div>




<div class="form-check form-switch mb-3">

<input asp-for="Status"
class="form-check-input"/>


<label asp-for="Status"
class="form-check-label">
Pagamento realizado
</label>


</div>




<button class="btn btn-success">

<i class="bi bi-check-circle"></i>
Salvar

</button>



</form>


</div>


</div>


</div>


@section Scripts{

@{
await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

}