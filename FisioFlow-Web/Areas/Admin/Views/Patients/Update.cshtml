@model FisioFlow_Web.Areas.Admin.Models.PatientViewModel

@{
    ViewData["Title"] = "Atualizar Cadastro do Paciente";
}


<div class="container-fluid px-4">


    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="fa-solid fa-user-pen text-primary"></i>

                Atualizar Cadastro do Paciente

            </h2>


            <p class="text-muted mb-0">

                Atualize os dados do paciente cadastrado.

            </p>

        </div>



        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left"></i>

            Voltar

        </a>


    </div>





    <div class="card shadow-sm border-0">


        <div class="card-header bg-primary text-white">


            <h5 class="mb-0">

                <i class="fa-solid fa-user"></i>

                Dados do Paciente

            </h5>


        </div>





        <div class="card-body">


            <form asp-action="Update"
                  method="post">


                @Html.AntiForgeryToken()


                <input asp-for="PatientId" type="hidden" />



                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>





                <div class="row">


                    <!-- Nome -->

                    <div class="col-md-8 mb-3">

                        <label asp-for="Name"
                               class="form-label">
                            Nome completo
                        </label>


                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Digite o nome completo" />


                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>





                    <!-- CPF -->

                    <div class="col-md-4 mb-3">


                        <label asp-for="CPF"
                               class="form-label">

                            CPF

                        </label>


                        <input asp-for="CPF"
                               id="CPF"
                               maxlength="14"
                               class="form-control"
                               placeholder="000.000.000-00" />


                        <span asp-validation-for="CPF"
                              class="text-danger">
                        </span>


                    </div>





                    <!-- Email -->

                    <div class="col-md-6 mb-3">


                        <label asp-for="Email"
                               class="form-label">

                            E-mail

                        </label>


                        <input asp-for="Email"
                               id="Email"
                               type="email"
                               class="form-control"
                               placeholder="email@email.com" />


                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>


                    </div>





                    <!-- RG -->

                    <div class="col-md-3 mb-3">


                        <label asp-for="RG"
                               class="form-label">

                            RG

                        </label>


                        <input asp-for="RG"
                               class="form-control"
                               placeholder="Digite o RG" />


                        <span asp-validation-for="RG"
                              class="text-danger">
                        </span>


                    </div>





                    <!-- Nascimento -->

                    <div class="col-md-3 mb-3">


                        <label asp-for="BirthDate"
                               class="form-label">

                            Data de nascimento

                        </label>


                        <input asp-for="BirthDate"
                               type="date"
                               class="form-control" />


                        <span asp-validation-for="BirthDate"
                              class="text-danger">
                        </span>


                    </div>





                    <!-- Telefone -->

                    <div class="col-md-4 mb-3">


                        <label asp-for="Phone"
                               class="form-label">

                            Telefone

                        </label>


                        <input asp-for="Phone"
                               id="Phone"
                               class="form-control"
                               placeholder="(11) 99999-9999" />


                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>


                    </div>





                    <!-- Convênio -->

                    <div class="col-md-8 mb-3">


                        <label asp-for="Insurance"
                               class="form-label">

                            Convênio médico

                        </label>


                        <input asp-for="Insurance"
                               class="form-control"
                               placeholder="Ex: Unimed" />


                        <span asp-validation-for="Insurance"
                              class="text-danger">
                        </span>


                    </div>





                    <!-- CEP -->

                    <div class="col-md-4 mb-3">


                        <label asp-for="PostalCode"
                               class="form-label">

                            CEP

                        </label>


                        <input asp-for="PostalCode"
                               id="PostalCode"
                               maxlength="9"
                               class="form-control"
                               placeholder="00000-000" />


                        <span asp-validation-for="PostalCode"
                              class="text-danger">
                        </span>


                    </div>





                    <!-- Endereço -->

                    <div class="col-md-8 mb-3">


                        <label asp-for="Address"
                               class="form-label">

                            Endereço

                        </label>


                        <input asp-for="Address"
                               id="Address"
                               class="form-control"
                               placeholder="Rua, Avenida..." />


                        <span asp-validation-for="Address"
                              class="text-danger">
                        </span>


                    </div>





                    <!-- Bairro -->

                    <div class="col-md-4 mb-3">


                        <label asp-for="Neighborhood"
                               class="form-label">

                            Bairro

                        </label>


                        <input asp-for="Neighborhood"
                               id="Neighborhood"
                               class="form-control" />


                        <span asp-validation-for="Neighborhood"
                              class="text-danger">
                        </span>


                    </div>





                    <!-- Cidade -->

                    <div class="col-md-6 mb-3>


                        <label asp-for="City"
                         class="form-label">

                        Cidade

                    </label>


                    <input asp-for="City"
                           id="City"
                           class="form-control" />


                    <span asp-validation-for="City"
                          class="text-danger">
                    </span>


                </div>





                <!-- Estado -->

                <div class="col-md-2 mb-3">


                    <label asp-for="State"
                           class="form-label">

                        Estado

                    </label>


                    <input asp-for="State"
                           id="State"
                           maxlength="2"
                           class="form-control"
                           placeholder="SP" />


                    <span asp-validation-for="State"
                          class="text-danger">
                    </span>


                </div>





                <!-- Histórico -->

                <div class="col-md-12 mb-3">


                    <label asp-for="MedicalHistory"
                           class="form-label">

                        Histórico médico

                    </label>


                    <textarea asp-for="MedicalHistory"
                              class="form-control"
                              rows="4"
                              placeholder="Informações médicas importantes">
                        </textarea>


                    <span asp-validation-for="MedicalHistory"
                          class="text-danger">
                    </span>


                </div>





                <!-- Observações -->

                <div class="col-md-12 mb-3">


                    <label asp-for="Notes"
                           class="form-label">

                        Observações

                    </label>


                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="3">
                        </textarea>


                    <span asp-validation-for="Notes"
                          class="text-danger">
                    </span>


                </div>





                <!-- Status -->

                <div class="col-md-3 mb-3">


                    <label asp-for="Status"
                           class="form-label">

                        Situação do paciente

                    </label>


                    <select asp-for="Status"
                            class="form-select">


                        <option value="true">
                            Ativo
                        </option>


                        <option value="false">
                            Inativo
                        </option>


                    </select>


                </div>


            </div>





            <div class="text-end mt-4">


                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>



                <button type="submit"
                        class="btn btn-primary">


                    <i class="fa-solid fa-save"></i>


                    Atualizar Paciente


                </button>


            </div>


        </form>


    </div>


</div>


</div>





@section Scripts {


    <partial name="_ValidationScriptsPartial" />


    <script src="~/js/patient.js"></script>


}