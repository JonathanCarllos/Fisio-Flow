@model IEnumerable<FisioFlow_Web.Areas.Admin.Models.MedicalRecordViewModel>

@{
    ViewData["Title"] = "Prontuários";

    var records = Model?.ToList()
        ?? new List<FisioFlow_Web.Areas.Admin.Models.MedicalRecordViewModel>();

    var total = records.Count;
}

<div class="container-fluid px-4 pb-4">

    <!-- Cabeçalho -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">

                <div class="d-flex align-items-center justify-content-center rounded-3 bg-success-subtle"
                     style="width: 46px; height: 46px;">

                    <i class="fas fa-file-medical text-success fs-5"></i>

                </div>

                <div>
                    <h2 class="fw-bold mb-0">
                        Prontuários
                    </h2>

                    <p class="text-muted mb-0 small">
                        Gerencie os prontuários e informações clínicas dos pacientes
                    </p>
                </div>

            </div>
        </div>

        <a asp-area="Admin"
           asp-controller="MedicalRecords"
           asp-action="Create"
           class="btn btn-success px-4 shadow-sm">

            <i class="fas fa-plus me-2"></i>
            Novo prontuário

        </a>

    </div>


    <!-- Indicadores -->
    <div class="row g-3 mb-4">

        <!-- Total -->
        <div class="col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between">

                        <div>

                            <span class="text-muted small">
                                Total de prontuários
                            </span>

                            <h3 class="fw-bold mb-0 mt-1">
                                @total
                            </h3>

                        </div>

                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-success-subtle"
                             style="width: 48px; height: 48px;">

                            <i class="fas fa-file-medical text-success"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Avaliações -->
        <div class="col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between">

                        <div>

                            <span class="text-muted small">
                                Avaliações iniciais
                            </span>

                            <h3 class="fw-bold mb-0 mt-1">
                                @records.Count(x =>
                                    x.RecordType == FisioFlow_Web.Enums.RecordType.InitialEvaluation)
                            </h3>

                        </div>

                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-primary-subtle"
                             style="width: 48px; height: 48px;">

                            <i class="fas fa-clipboard-check text-primary"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Evoluções -->
        <div class="col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between">

                        <div>

                            <span class="text-muted small">
                                Evoluções
                            </span>

                            <h3 class="fw-bold mb-0 mt-1">
                                @records.Count(x =>
                                    x.RecordType == FisioFlow_Web.Enums.RecordType.Evolution)
                            </h3>

                        </div>

                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-info-subtle"
                             style="width: 48px; height: 48px;">

                            <i class="fas fa-chart-line text-info"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Exames -->
        <div class="col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center justify-content-between">

                        <div>

                            <span class="text-muted small">
                                Exames
                            </span>

                            <h3 class="fw-bold mb-0 mt-1">
                                @records.Count(x =>
                                    x.RecordType == FisioFlow_Web.Enums.RecordType.Exam)
                            </h3>

                        </div>

                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-warning-subtle"
                             style="width: 48px; height: 48px;">

                            <i class="fas fa-file-medical-alt text-warning"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Card principal -->
    <div class="card border-0 shadow-sm overflow-hidden">

        <!-- Cabeçalho -->
        <div class="card-header bg-white border-0 px-4 py-3">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

                <div>

                    <h5 class="fw-bold mb-1">
                        <i class="fas fa-list-ul text-success me-2"></i>
                        Lista de prontuários
                    </h5>

                    <small class="text-muted">
                        Registros clínicos cadastrados no sistema
                    </small>

                </div>

                <div>

                    <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">

                        <i class="fas fa-database me-1"></i>

                        @total
                        @(total == 1 ? "registro" : "registros")

                    </span>

                </div>

            </div>

        </div>


        <!-- Conteúdo -->
        <div class="card-body p-0">

            @if (records.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr class="bg-light">

                                <th class="ps-4 py-3 text-muted small text-uppercase">
                                    #
                                </th>

                                <th class="py-3 text-muted small text-uppercase">
                                    Tipo
                                </th>

                                <th class="py-3 text-muted small text-uppercase">
                                    Prontuário
                                </th>

                                <th class="py-3 text-muted small text-uppercase">
                                    Paciente
                                </th>

                                <th class="py-3 text-muted small text-uppercase">
                                    Fisioterapeuta
                                </th>

                                <th class="py-3 text-muted small text-uppercase">
                                    Sessão
                                </th>

                                <th class="py-3 text-muted small text-uppercase">
                                    Arquivo
                                </th>

                                <th class="text-end pe-4 py-3 text-muted small text-uppercase">
                                    Ações
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in records)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td class="ps-4">

                                        <span class="fw-semibold text-muted">
                                            #@item.MedicalRecordId
                                        </span>

                                    </td>


                                    <!-- Tipo -->
                                    <td>

                                        @switch (item.RecordType)
                                        {
                                            case FisioFlow_Web.Enums.RecordType.InitialEvaluation:

                                                <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                                                    <i class="fas fa-clipboard-check me-1"></i>
                                                    Avaliação Inicial
                                                </span>

                                                break;

                                            case FisioFlow_Web.Enums.RecordType.Evolution:

                                                <span class="badge rounded-pill bg-info-subtle text-info px-3 py-2">
                                                    <i class="fas fa-chart-line me-1"></i>
                                                    Evolução
                                                </span>

                                                break;

                                            case FisioFlow_Web.Enums.RecordType.Exam:

                                               <span class="badge rounded-pill bg-warning-subtle text-dark px-3 py-2 fw-bold">
                                                   <i class="fas fa-file-medical-alt me-1"></i>
                                                     Exame
                                               </span>

                                                break;

                                            case FisioFlow_Web.Enums.RecordType.Discharge:

                                                <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                                    <i class="fas fa-check-circle me-1"></i>
                                                    Alta
                                                </span>

                                                break;

                                            default:

                                                <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">
                                                    Não informado
                                                </span>

                                                break;
                                        }

                                    </td>


                                    <!-- Título -->
                                    <td>

                                        <div style="min-width: 220px;">

                                            @if (!string.IsNullOrWhiteSpace(item.Title))
                                            {
                                                <div class="fw-semibold text-dark">
                                                    @item.Title
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted">
                                                    Sem título
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(item.FunctionalDiagnosis))
                                            {
                                                <div class="small text-muted mt-1"
                                                     style="max-width: 300px;">

                                                    <i class="fas fa-stethoscope me-1"></i>

                                                    @item.FunctionalDiagnosis

                                                </div>
                                            }

                                        </div>

                                    </td>


                                    <!-- Paciente -->
                                    <td>

                                        <div class="d-flex align-items-center gap-2"
                                             style="min-width: 190px;">

                                            <div class="d-flex align-items-center justify-content-center rounded-circle bg-success-subtle flex-shrink-0"
                                                 style="width: 40px; height: 40px;">

                                                <i class="fas fa-user text-success"></i>

                                            </div>

                                            <div class="overflow-hidden">

                                                @if (!string.IsNullOrWhiteSpace(item.PatientName))
                                                {
                                                    <div class="fw-semibold text-truncate">
                                                        @item.PatientName
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted">
                                                        Não informado
                                                    </div>
                                                }

                                                <small class="text-muted">
                                                    Paciente #@item.PatientId
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Fisioterapeuta -->
                                    <td>

                                        <div class="d-flex align-items-center gap-2"
                                             style="min-width: 200px;">

                                            <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary-subtle flex-shrink-0"
                                                 style="width: 40px; height: 40px;">

                                                <i class="fas fa-user-md text-primary"></i>

                                            </div>

                                            <div class="overflow-hidden">

                                                @if (!string.IsNullOrWhiteSpace(item.PhysiotherapistName))
                                                {
                                                    <div class="fw-semibold text-truncate">
                                                        @item.PhysiotherapistName
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted">
                                                        Não informado
                                                    </div>
                                                }

                                                <small class="text-muted">
                                                    Fisioterapeuta #@item.PhysiotherapistId
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Sessão -->
                                    <td>

                                        @if (item.SessionId.HasValue)
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">

                                                <i class="fas fa-calendar-check me-1"></i>

                                                #@item.SessionId

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">

                                                <i class="fas fa-minus-circle me-1"></i>

                                                Não vinculada

                                            </span>
                                        }

                                    </td>


                                    <!-- Arquivo -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.FileUrl))
                                        {
                                            <a href="@item.FileUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-success rounded-3"
                                               title="Abrir arquivo">

                                                <i class="fas fa-paperclip me-1"></i>
                                                Abrir

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- Ações -->
                                    <td class="text-end pe-4">

                                        <div class="d-flex justify-content-end gap-1">

                                            <!-- Visualizar -->
                                            <a asp-area="Admin"
                                               asp-controller="MedicalRecords"
                                               asp-action="Details"
                                               asp-route-id="@item.MedicalRecordId"
                                               class="btn btn-sm btn-light border rounded-3"
                                               title="Visualizar">

                                                <i class="fas fa-eye text-primary"></i>

                                            </a>


                                            <!-- Editar -->
                                            <a asp-area="Admin"
                                               asp-controller="MedicalRecords"
                                               asp-action="Edit"
                                               asp-route-id="@item.MedicalRecordId"
                                               class="btn btn-sm btn-light border rounded-3"
                                               title="Editar">

                                                <i class="fas fa-edit text-warning"></i>

                                            </a>


                                            <!-- Excluir -->
                                            <a asp-area="Admin"
                                               asp-controller="MedicalRecords"
                                               asp-action="Delete"
                                               asp-route-id="@item.MedicalRecordId"
                                               class="btn btn-sm btn-light border rounded-3"
                                               title="Excluir">

                                                <i class="fas fa-trash text-danger"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Estado vazio -->

                <div class="text-center py-5 px-3">

                    <div class="d-flex align-items-center justify-content-center rounded-circle bg-success-subtle mx-auto mb-4"
                         style="width: 90px; height: 90px;">

                        <i class="fas fa-file-medical text-success fs-1"></i>

                    </div>

                    <h5 class="fw-bold mb-2">
                        Nenhum prontuário encontrado
                    </h5>

                    <p class="text-muted mb-4">
                        Ainda não existem prontuários cadastrados no sistema.
                    </p>

                    <a asp-area="Admin"
                       asp-controller="MedicalRecords"
                       asp-action="Create"
                       class="btn btn-success px-4">

                        <i class="fas fa-plus me-2"></i>

                        Cadastrar primeiro prontuário

                    </a>

                </div>
            }

        </div>

    </div>

</div>