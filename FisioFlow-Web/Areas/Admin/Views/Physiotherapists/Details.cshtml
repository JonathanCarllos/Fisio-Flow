@model FisioFlow_Web.Areas.Admin.Models.PhysiotherapistViewModel

@{
    ViewData["Title"] = "Detalhes do Fisioterapeuta";
}

<div class="container-fluid px-4">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-person-badge text-success me-2"></i>
                Detalhes do Fisioterapeuta
            </h2>

            <p class="text-muted mb-0">
                Visualize as informações completas do profissional.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Voltar

            </a>

            <a asp-action="Update"
               asp-route-id="@Model.PhysiotherapistId"
               class="btn btn-success">

                <i class="bi bi-pencil me-1"></i>
                Editar

            </a>

        </div>

    </div>

    <!-- Card principal -->
    <div class="card shadow-sm border-0">

        <!-- Header -->
        <div class="card-header bg-success text-white py-3">

            <div class="d-flex align-items-center">

                <div class="bg-white bg-opacity-25 rounded-circle p-2 me-3">
                    <i class="bi bi-person-badge fs-4"></i>
                </div>

                <div>

                    <h5 class="mb-0 fw-bold">
                        @Model.Name
                    </h5>

                    <small class="opacity-75">
                        @Model.Specialty
                    </small>

                </div>

            </div>

        </div>

        <div class="card-body p-4">

            <!-- =============================== -->
            <!-- DADOS PROFISSIONAIS -->
            <!-- =============================== -->

            <div class="mb-4">

                <div class="d-flex align-items-center mb-3">

                    <div class="bg-success bg-opacity-10 rounded-circle p-2 me-2">
                        <i class="bi bi-briefcase text-success"></i>
                    </div>

                    <div>
                        <h5 class="mb-0 fw-bold">
                            Dados profissionais
                        </h5>

                        <small class="text-muted">
                            Informações profissionais do fisioterapeuta
                        </small>
                    </div>

                </div>

                <div class="row g-3">

                    <!-- Nome -->
                    <div class="col-md-6">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-person me-1"></i>
                                Nome completo
                            </span>

                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.Name)
                                    ? "Não informado"
                                    : Model.Name)
                            </div>

                        </div>

                    </div>

                    <!-- CREFITO -->
                    <div class="col-md-6">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-card-text me-1"></i>
                                CREFITO
                            </span>

                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.Crefito)
                                    ? "Não informado"
                                    : Model.Crefito)
                            </div>

                        </div>

                    </div>

                    <!-- Especialidade -->
                    <div class="col-md-6">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-heart-pulse me-1"></i>
                                Especialidade
                            </span>

                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.Specialty)
                                    ? "Não informado"
                                    : Model.Specialty)
                            </div>

                        </div>

                    </div>

                    <!-- Horários -->
                    <div class="col-md-6">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-clock me-1"></i>
                                Horários disponíveis
                            </span>

                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.AvailableHours)
                                    ? "Não informado"
                                    : Model.AvailableHours)
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <hr class="my-4">

            <!-- =============================== -->
            <!-- DOCUMENTOS E CONTATO -->
            <!-- =============================== -->

            <div class="mb-4">

                <div class="d-flex align-items-center mb-3">

                    <div class="bg-success bg-opacity-10 rounded-circle p-2 me-2">
                        <i class="bi bi-person-vcard text-success"></i>
                    </div>

                    <div>
                        <h5 class="mb-0 fw-bold">
                            Documentos e contato
                        </h5>

                        <small class="text-muted">
                            Documentos pessoais e informações de contato
                        </small>
                    </div>

                </div>

                <div class="row g-3">

                    <!-- CPF -->
                    <div class="col-md-4">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-person-vcard me-1"></i>
                                CPF
                            </span>

                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.CPF)
                                    ? "Não informado"
                                    : Model.CPF)
                            </div>

                        </div>

                    </div>

                    <!-- RG -->
                    <div class="col-md-4">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-card-heading me-1"></i>
                                RG
                            </span>

                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.RG)
                                    ? "Não informado"
                                    : Model.RG)
                            </div>

                        </div>

                    </div>

                    <!-- Data nascimento -->
                    <div class="col-md-4">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-calendar3 me-1"></i>
                                Data de nascimento
                            </span>

                            <div class="info-value">

                                @(Model.BirthDate == DateTime.MinValue ? "Não informado" : Model.BirthDate.ToString("dd/MM/yyyy"))
                            </div>

                        </div>

                    </div>

                    <!-- Email -->
                    <div class="col-md-6">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-envelope me-1"></i>
                                E-mail
                            </span>

                            <div class="info-value">

                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                {
                                    <a href="mailto:@Model.Email"
                                       class="text-decoration-none">

                                        @Model.Email

                                    </a>
                                }
                                else
                                {
                                    <span>Não informado</span>
                                }

                            </div>

                        </div>

                    </div>

                    <!-- Telefone -->
                    <div class="col-md-6">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-telephone me-1"></i>
                                Telefone
                            </span>

                            <div class="info-value">

                                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                                {
                                    <a href="tel:@Model.Phone"
                                       class="text-decoration-none">

                                        @Model.Phone

                                    </a>
                                }
                                else
                                {
                                    <span>Não informado</span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <hr class="my-4">

            <!-- =============================== -->
            <!-- ENDEREÇO -->
            <!-- =============================== -->

            <div class="mb-4">

                <div class="d-flex align-items-center mb-3">

                    <div class="bg-success bg-opacity-10 rounded-circle p-2 me-2">
                        <i class="bi bi-geo-alt text-success"></i>
                    </div>

                    <div>
                        <h5 class="mb-0 fw-bold">
                            Endereço
                        </h5>

                        <small class="text-muted">
                            Endereço cadastrado do profissional
                        </small>
                    </div>

                </div>

                <div class="row g-3">

                    <!-- Endereço -->
                    <div class="col-md-8">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-house me-1"></i>
                                Endereço
                            </span>

                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.Address)
                                    ? "Não informado"
                                    : Model.Address)
                            </div>

                        </div>

                    </div>

                    <!-- CEP -->
                    <div class="col-md-4">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-mailbox me-1"></i>
                                CEP
                            </span>

                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.PostalCode)
                                    ? "Não informado"
                                    : Model.PostalCode)
                            </div>

                        </div>

                    </div>

                    <!-- Bairro -->
                    <div class="col-md-4">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-buildings me-1"></i>
                                Bairro
                            </span>

                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.Neighborhood)
                                    ? "Não informado"
                                    : Model.Neighborhood)
                            </div>

                        </div>

                    </div>

                    <!-- Cidade -->
                    <div class="col-md-5">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-building me-1"></i>
                                Cidade
                            </span>

                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.City)
                                    ? "Não informado"
                                    : Model.City)
                            </div>

                        </div>

                    </div>

                    <!-- Estado -->
                    <div class="col-md-3">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-map me-1"></i>
                                Estado
                            </span>

                            <div class="info-value">
                                @(string.IsNullOrWhiteSpace(Model.State)
                                    ? "Não informado"
                                    : Model.State)
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <hr class="my-4">

            <!-- =============================== -->
            <!-- CONFIGURAÇÕES -->
            <!-- =============================== -->

            <div class="mb-4">

                <div class="d-flex align-items-center mb-3">

                    <div class="bg-success bg-opacity-10 rounded-circle p-2 me-2">
                        <i class="bi bi-sliders text-success"></i>
                    </div>

                    <div>
                        <h5 class="mb-0 fw-bold">
                            Configurações
                        </h5>

                        <small class="text-muted">
                            Status e identificação visual
                        </small>
                    </div>

                </div>

                <div class="row g-3">

                    <!-- Status -->
                    <div class="col-md-6">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-toggle-on me-1"></i>
                                Status
                            </span>

                            <div class="mt-2">

                                @if (Model.Status)
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Inativo
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                    <!-- Cor -->
                    <div class="col-md-6">

                        <div class="info-box">

                            <span class="info-label">
                                <i class="bi bi-palette me-1"></i>
                                Cor de identificação
                            </span>

                            <div class="d-flex align-items-center gap-3 mt-2">

                                <div class="color-preview"
                                     style="background-color: @(string.IsNullOrWhiteSpace(Model.Color) ? "#10b981" : Model.Color);">
                                </div>

                                <span class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.Color)
                                        ? "#10B981"
                                        : Model.Color.ToUpper())
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Rodapé -->
            <div class="border-top pt-4 mt-4">

                <div class="d-flex justify-content-between align-items-center">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>
                        Voltar para lista

                    </a>

                    <a asp-action="Update"
                       asp-route-id="@Model.PhysiotherapistId"
                       class="btn btn-success px-4">

                        <i class="bi bi-pencil me-1"></i>
                        Editar Fisioterapeuta

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .info-box {
        height: 100%;
        padding: 16px 18px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        transition: all .2s ease;
    }

        .info-box:hover {
            border-color: #a7f3d0;
            background: #f0fdf4;
        }

    .info-label {
        display: block;
        margin-bottom: 6px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .info-value {
        color: #1e293b;
        font-size: 15px;
        font-weight: 600;
        word-break: break-word;
    }

        .info-value a {
            color: #059669;
        }

            .info-value a:hover {
                color: #047857;
            }

    .color-preview {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        border: 2px solid #ffffff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, .15);
    }

</style>