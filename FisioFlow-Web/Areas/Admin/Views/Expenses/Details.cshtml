@model FisioFlow_Web.Areas.Admin.Models.ExpenseViewModel

@{
    ViewData["Title"] = "Detalhes da Despesa";
}

<div class="container-fluid px-4 pb-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>

            <div class="d-flex align-items-center gap-3 mb-1">

                <div class="d-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10"
                     style="width: 46px; height: 46px;">

                    <i class="fas fa-file-invoice-dollar text-primary fs-5"></i>

                </div>

                <h2 class="fw-bold mb-0">
                    Detalhes da Despesa
                </h2>

            </div>

            <p class="text-muted mb-0">
                Visualize todas as informações da despesa cadastrada.
            </p>

        </div>

        <div class="d-flex flex-column flex-sm-row gap-2">

            <a asp-area="Admin"
               asp-controller="Expenses"
               asp-action="Edit"
               asp-route-id="@Model.ExpenseId"
               class="btn btn-primary px-4">

                <i class="fas fa-edit me-2"></i>
                Editar

            </a>

            <a asp-area="Admin"
               asp-controller="Expenses"
               asp-action="Index"
               class="btn btn-light border px-4">

                <i class="fas fa-arrow-left me-2"></i>
                Voltar

            </a>

        </div>

    </div>

    <div class="row justify-content-center">

        <div class="col-12 col-xl-10">

            <div class="card border-0 shadow-sm overflow-hidden">

                <div class="card-header bg-white border-0 px-4 py-4">

                    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">

                        <div class="d-flex align-items-center gap-3">

                            <div class="d-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10"
                                 style="width: 48px; height: 48px;">

                                <i class="fas fa-receipt text-primary fs-5"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-1">
                                    Informações da Despesa
                                </h5>

                                <span class="text-muted small">
                                    Despesa #@Model.ExpenseId
                                </span>

                            </div>

                        </div>

                        @if (Model.Status)
                        {
                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">

                                <i class="fas fa-check-circle me-1"></i>
                                Ativa

                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger px-3 py-2">

                                <i class="fas fa-times-circle me-1"></i>
                                Inativa

                            </span>
                        }

                    </div>

                </div>

                <div class="card-body px-4 py-4">

                    <div class="row g-4">

                        <div class="col-12">

                            <div class="card border bg-light">

                                <div class="card-body p-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10"
                                             style="width: 52px; height: 52px;">

                                            <i class="fas fa-align-left text-primary fs-5"></i>

                                        </div>

                                        <div>

                                            <span class="text-muted small d-block">
                                                DESCRIÇÃO
                                            </span>

                                            <span class="fw-bold fs-5">
                                                @Model.Description
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-12 col-md-6">

                            <div class="card border h-100">

                                <div class="card-body p-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-danger bg-opacity-10"
                                             style="width: 48px; height: 48px;">

                                            <i class="fas fa-money-bill-wave text-danger"></i>

                                        </div>

                                        <div>

                                            <span class="text-muted small d-block">
                                                VALOR
                                            </span>

                                            <span class="fw-bold fs-4 text-danger">
                                                @Model.Amount.ToString("C2")
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-12 col-md-6">

                            <div class="card border h-100">

                                <div class="card-body p-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-info bg-opacity-10"
                                             style="width: 48px; height: 48px;">

                                            <i class="far fa-calendar-alt text-info"></i>

                                        </div>

                                        <div>

                                            <span class="text-muted small d-block">
                                                DATA DA DESPESA
                                            </span>

                                            <span class="fw-bold fs-5">
                                                @Model.Date.ToString("dd/MM/yyyy")
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-12 col-md-6">

                            <div class="card border h-100">

                                <div class="card-body p-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-warning bg-opacity-10"
                                             style="width: 48px; height: 48px;">

                                            <i class="fas fa-tags text-warning"></i>

                                        </div>

                                        <div>

                                            <span class="text-muted small d-block">
                                                CATEGORIA
                                            </span>

                                            <span class="fw-bold fs-5">

                                                @switch (Model.Category)
                                                {
                                                    case FisioFlow_Web.Enums.Category.rent:
                                                        @:Aluguel
                                                        break;

                                                    case FisioFlow_Web.Enums.Category.utilities:
                                                        @:Contas / Utilidades
                                                        break;

                                                    case FisioFlow_Web.Enums.Category.supplies:
                                                        @:Materiais
                                                        break;

                                                    case FisioFlow_Web.Enums.Category.equipment:
                                                        @:Equipamentos
                                                        break;

                                                    case FisioFlow_Web.Enums.Category.salary:
                                                        @:Salários
                                                        break;

                                                    case FisioFlow_Web.Enums.Category.marketing:
                                                        @:Marketing
                                                        break;

                                                    case FisioFlow_Web.Enums.Category.maintenance:
                                                        @:Manutenção
                                                        break;

                                                    case FisioFlow_Web.Enums.Category.other:
                                                        @:Outros
                                                        break;

                                                    default:
                                                        @:Não informado
                                                        break;
                                                }

                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-12 col-md-6">

                            <div class="card border h-100">

                                <div class="card-body p-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-success bg-opacity-10"
                                             style="width: 48px; height: 48px;">

                                            <i class="fas fa-credit-card text-success"></i>

                                        </div>

                                        <div>

                                            <span class="text-muted small d-block">
                                                FORMA DE PAGAMENTO
                                            </span>

                                            <span class="fw-bold fs-5">

                                                @switch (Model.PaymentMethod)
                                                {
                                                    case FisioFlow_Web.Enums.PaymentMethod.Cash:
                                                        @:Dinheiro
                                                        break;

                                                    case FisioFlow_Web.Enums.PaymentMethod.CreditCard:
                                                        @:Cartão de Crédito
                                                        break;

                                                    case FisioFlow_Web.Enums.PaymentMethod.DebitCard:
                                                        @:Cartão de Débito
                                                        break;

                                                    case FisioFlow_Web.Enums.PaymentMethod.Pix:
                                                        @:Pix
                                                        break;

                                                    case FisioFlow_Web.Enums.PaymentMethod.BankTransfer:
                                                        @:Transferência Bancária
                                                        break;

                                                    default:
                                                        @:Não informado
                                                        break;
                                                }

                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="card border">

                                <div class="card-body p-4">

                                    <div class="d-flex align-items-start gap-3">

                                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-secondary bg-opacity-10"
                                             style="width: 48px; height: 48px; flex-shrink: 0;">

                                            <i class="fas fa-sticky-note text-secondary"></i>

                                        </div>

                                        <div class="flex-grow-1">

                                            <span class="text-muted small d-block mb-2">
                                                OBSERVAÇÕES
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(Model.Notes))
                                            {
                                                <p class="mb-0 text-muted"
                                                   style="white-space: pre-line;">
                                                    @Model.Notes
                                                </p>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Nenhuma observação informada.
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <hr class="my-4">

                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2">

                        <a asp-area="Admin"
                           asp-controller="Expenses"
                           asp-action="Delete"
                           asp-route-id="@Model.ExpenseId"
                           class="btn btn-outline-danger px-4">

                            <i class="fas fa-trash me-2"></i>
                            Excluir Despesa

                        </a>

                        <div class="d-flex flex-column flex-sm-row gap-2">

                            <a asp-area="Admin"
                               asp-controller="Expenses"
                               asp-action="Index"
                               class="btn btn-light border px-4">

                                <i class="fas fa-arrow-left me-2"></i>
                                Voltar

                            </a>

                            <a asp-area="Admin"
                               asp-controller="Expenses"
                               asp-action="Edit"
                               asp-route-id="@Model.ExpenseId"
                               class="btn btn-primary px-4">

                                <i class="fas fa-edit me-2"></i>
                                Editar Despesa

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>