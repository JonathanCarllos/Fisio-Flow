@model FisioFlow_Web.Areas.Admin.Models.TreatmentViewModel

@{
    ViewData["Title"] = "Detalhes do Tratamento";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-success mb-0">
                <i class="bi bi-clipboard2-pulse me-2"></i>
                Detalhes do Tratamento
            </h2>

            <small class="text-muted">
                Informações completas do tratamento
            </small>
        </div>


        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.TreatmentId"
               class="btn btn-warning">

                <i class="bi bi-pencil-square me-1"></i>
                Editar

            </a>


            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Voltar

            </a>

        </div>

    </div>



    <div class="card shadow-sm border-0">

        <div class="card-body">


            <div class="row g-3">


                <div class="col-md-6">

                    <div class="border rounded p-3">

                        <h6 class="text-success fw-bold">
                            <i class="bi bi-person me-2"></i>
                            Paciente
                        </h6>


                        <p class="mb-0">
                            @ViewBag.PatientName
                        </p>

                    </div>

                </div>




                <div class="col-md-6">

                    <div class="border rounded p-3">

                        <h6 class="text-success fw-bold">
                            <i class="bi bi-person-badge me-2"></i>
                            Fisioterapeuta
                        </h6>


                        <p class="mb-0">
                            @ViewBag.PhysiotherapistName
                        </p>

                    </div>

                </div>




                <div class="col-md-4">

                    <div class="border rounded p-3">

                        <strong>
                            Código
                        </strong>


                        <p class="mb-0">
                            @Model.TreatmentId
                        </p>

                    </div>

                </div>




                <div class="col-md-4">

                    <div class="border rounded p-3">

                        <strong>
                            Tipo
                        </strong>


                        <p class="mb-0">
                            @Model.Type
                        </p>

                    </div>

                </div>




                <div class="col-md-4">

                    <div class="border rounded p-3">

                        <strong>
                            Status
                        </strong>


                        <p class="mb-0">

                            @if (Model.Status)
                            {
                                <span class="badge bg-success">
                                    Ativo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Finalizado
                                </span>
                            }

                        </p>

                    </div>

                </div>




                <div class="col-md-12">

                    <div class="border rounded p-3">

                        <strong>
                            Diagnóstico
                        </strong>


                        <p class="mb-0 mt-2">
                            @Model.Diagnosis
                        </p>

                    </div>

                </div>




                <div class="col-md-4">

                    <div class="border rounded p-3">

                        <strong>
                            Total de Sessões
                        </strong>


                        <p class="mb-0">
                            @Model.TotalSessions
                        </p>

                    </div>

                </div>




                <div class="col-md-4">

                    <div class="border rounded p-3">

                        <strong>
                            Sessões Concluídas
                        </strong>


                        <p class="mb-0">
                            @Model.CompletedSessions
                        </p>

                    </div>

                </div>




                <div class="col-md-4">

                    <div class="border rounded p-3">

                        <strong>
                            Sessões Restantes
                        </strong>


                        <p class="mb-0">
                            @(Model.TotalSessions - Model.CompletedSessions)
                        </p>

                    </div>

                </div>




                <div class="col-md-6">

                    <div class="border rounded p-3">

                        <strong>
                            Data de Início
                        </strong>


                        <p class="mb-0">
                            @Model.StartDate.ToString("dd/MM/yyyy")
                        </p>

                    </div>

                </div>




                <div class="col-md-6">

                    <div class="border rounded p-3">

                        <strong>
                            Data de Término
                        </strong>


                        <p class="mb-0">
                            @Model.EndDate.ToString("dd/MM/yyyy")
                        </p>

                    </div>

                </div>




                <div class="col-md-12">

                    <div class="border rounded p-3">

                        <strong>
                            Exercícios
                        </strong>


                        <p class="mb-0 mt-2">

                            @(string.IsNullOrEmpty(Model.Exercises)
                                ? "Nenhum exercício informado."
                                : Model.Exercises)

                        </p>

                    </div>

                </div>




                <div class="col-md-12">

                    <div class="border rounded p-3">

                        <strong>
                            Observações
                        </strong>


                        <p class="mb-0 mt-2">

                            @(string.IsNullOrEmpty(Model.Observations)
                                ? "Nenhuma observação informada."
                                : Model.Observations)

                        </p>

                    </div>

                </div>


            </div>


        </div>

    </div>


</div>